---
// Bewerbungsformular. Варианты: karriere (Stellen/Jobs), ausbildung (Ausbildung, Praktikum, FSJ, Quereinstieg).
// Отправка и защита от спама — как в ContactForm: honeypot + минимальное время заполнения, fetch на SITE.formEndpoint;
// пустой endpoint = режим превью. Файлы (Lebenslauf) через статический endpoint не передаются — см. подсказку в форме.
import { SITE } from '../config/site';
interface Props { variant?: 'karriere' | 'ausbildung'; id?: string; position?: string }
const { variant = 'karriere', id = 'bewerbung', position } = Astro.props;
const subject = { karriere: 'Bewerbung Stelle', ausbildung: 'Bewerbung Ausbildung/Praktikum' }[variant];
const positions = ['Pflegefachkraft (m/w/d)', 'Pflegehelfer/in (m/w/d)', 'Betreuungskraft / Alltagsbegleiter/in (m/w/d)', 'Initiativbewerbung'];
const abschluss = ['Hauptschulabschluss', 'Mittlere Reife (Realschulabschluss)', 'Fachoberschulreife', 'Fachhochschulreife / Abitur', 'Noch in der Schule', 'Sonstiger Abschluss'];
const wunsch = ['Ausbildung', 'Praktikum', 'FSJ / BFD', 'Quereinstieg'];
const jahr = new Date().getFullYear();
---
<form class="form" id={id} data-application-form data-endpoint={SITE.formEndpoint} novalidate>
  <input type="hidden" name="subject" value={`Website: ${subject}`} />
  <input type="hidden" name="from_page" value={Astro.url.pathname} />
  {variant === 'karriere' ? (
    <div class="field">
      <label for={`${id}-position`}>Auf welche Stelle bewerben Sie sich? <span class="req">*</span></label>
      <select id={`${id}-position`} name="position" required>
        {positions.map((p) => <option value={p} selected={p === position}>{p}</option>)}
      </select>
      <span class="err" aria-live="polite"></span>
    </div>
  ) : (
    <fieldset class="seg field">
      <legend>Wofür interessieren Sie sich? </legend>
      {wunsch.map((v, i) => (
        <label><input type="radio" name="wunsch" value={v} checked={v === position || (!position && i === 0)} /><span>{v}</span></label>
      ))}
    </fieldset>
  )}
  <div class="row">
    <div class="field">
      <label for={`${id}-name`}>Ihr Name <span class="req">*</span></label>
      <input id={`${id}-name`} name="name" autocomplete="name" required minlength="2" />
      <span class="err" aria-live="polite"></span>
    </div>
    {variant === 'ausbildung' && (
      <div class="field">
        <label for={`${id}-jahr`}>Geburtsjahr <span class="req">*</span></label>
        <input id={`${id}-jahr`} name="geburtsjahr" type="number" inputmode="numeric" required min="1940" max={jahr - 14} placeholder="z. B. 2008" />
        <span class="err" aria-live="polite"></span>
      </div>
    )}
  </div>
  <div class="row">
    <div class="field">
      <label for={`${id}-phone`}>Telefon <span class="req">*</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9 +\(\)\/\-]{6,}" />
      <span class="err" aria-live="polite"></span>
    </div>
    <div class="field">
      <label for={`${id}-email`}>E-Mail <span class="req">*</span></label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      <span class="err" aria-live="polite"></span>
    </div>
  </div>
  {variant === 'karriere' ? (
    <>
      <div class="field">
        <label for={`${id}-quali`}>Qualifikation und Berufserfahrung <span class="muted">(optional)</span></label>
        <textarea id={`${id}-quali`} name="qualifikation" placeholder="z. B. Altenpflegerin, 5 Jahre ambulant, Führerschein Klasse B"></textarea>
      </div>
      <div class="row">
        <div class="field">
          <label for={`${id}-start`}>Frühester Eintritt <span class="muted">(optional)</span></label>
          <input id={`${id}-start`} name="eintritt" type="date" />
        </div>
      </div>
      <fieldset class="seg field">
        <legend>Gewünschte Arbeitszeit </legend>
        {['Vollzeit', 'Teilzeit', 'Minijob'].map((v, i) => (
          <label><input type="radio" name="arbeitszeit" value={v} checked={i === 0} /><span>{v}</span></label>
        ))}
      </fieldset>
    </>
  ) : (
    <div class="row">
      <div class="field">
        <label for={`${id}-abschluss`}>Schulabschluss <span class="req">*</span></label>
        <select id={`${id}-abschluss`} name="schulabschluss" required>
          <option value="">Bitte wählen</option>
          {abschluss.map((a) => <option value={a}>{a}</option>)}
        </select>
        <span class="err" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for={`${id}-start`}>Gewünschter Beginn <span class="muted">(optional)</span></label>
        <input id={`${id}-start`} name="beginn" type="date" />
      </div>
    </div>
  )}
  <div class="field">
    <label for={`${id}-msg`}>Ihre Nachricht <span class="muted">(optional)</span></label>
    <textarea id={`${id}-msg`} name="message" placeholder={variant === 'karriere' ? 'Was möchten Sie uns noch mitteilen?' : 'Warum interessiert Sie die Pflege? Haben Sie schon Erfahrung?'}></textarea>
  </div>
  <p class="muted note cv">
    Lebenslauf und Zeugnisse bitte gern per E-Mail an <a href={`mailto:${SITE.email}`}>{SITE.email}</a> oder per WhatsApp schicken – ein Datei-Upload ist hier leider nicht möglich.
  </p>
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="consent"><input type="checkbox" name="datenschutz" required /> <span>Ich bin einverstanden, dass meine Angaben zur Bearbeitung meiner Bewerbung gespeichert und verarbeitet werden. Details in der <a href="/datenschutz/" target="_blank">Datenschutzerklärung</a>. <span class="req">*</span></span></label>
  <button class="btn btn--primary" type="submit">Bewerbung absenden</button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="muted note">Wir melden uns in der Regel innerhalb von 2 Werktagen bei Ihnen. Ihre Daten werden vertraulich behandelt.</p>
</form>
<script>
  const MSG = {
    required: 'Bitte füllen Sie dieses Feld aus.',
    phone: 'Bitte geben Sie eine gültige Telefonnummer an.',
    email: 'Bitte prüfen Sie die E-Mail-Adresse.',
    year: 'Bitte geben Sie ein gültiges Geburtsjahr an (vierstellig).',
    consent: 'Bitte stimmen Sie der Datenverarbeitung zu.',
    ok: 'Vielen Dank für Ihre Bewerbung! Sie ist bei uns angekommen. Wir melden uns schnellstmöglich bei Ihnen.',
    preview: 'Vorschau-Modus: Das Formular ist geprüft, wird aber noch nicht versendet (Empfänger wird beim Livegang hinterlegt).',
    fail: 'Leider ist ein Fehler aufgetreten. Bitte rufen Sie uns an: 0231 54 67 686.',
    spam: 'Bitte nehmen Sie sich einen Moment Zeit und versuchen Sie es erneut.',
  };
  type Field = HTMLInputElement | HTMLSelectElement;
  document.querySelectorAll<HTMLFormElement>('[data-application-form]').forEach((form) => {
    const started = Date.now();
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const show = (cls: 'ok' | 'fail', text: string) => { status.className = `form-status ${cls}`; status.textContent = text; };
    const check = (el: Field) => {
      const err = el.closest('.field')?.querySelector<HTMLElement>('.err');
      let m = '';
      if (el.validity.valueMissing) m = MSG.required;
      else if (el.type === 'tel' && el.validity.patternMismatch) m = MSG.phone;
      else if (el.type === 'email' && el.validity.typeMismatch) m = MSG.email;
      else if (el.type === 'number' && (el.validity.rangeUnderflow || el.validity.rangeOverflow || el.validity.badInput)) m = MSG.year;
      el.setAttribute('aria-invalid', m ? 'true' : 'false');
      if (err) err.textContent = m;
      return !m;
    };
    const sel = 'input[required]:not([type=checkbox]), select[required]';
    form.querySelectorAll<Field>(sel).forEach((el) => el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'blur', () => check(el)));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<Field>(sel)];
      const valid = fields.map(check).every(Boolean);
      const consent = form.querySelector<HTMLInputElement>('input[name=datenschutz]')!;
      if (!valid) { fields.find((f) => f.getAttribute('aria-invalid') === 'true')?.focus(); return; }
      if (!consent.checked) { show('fail', MSG.consent); consent.focus(); return; }
      const data = new FormData(form);
      if (data.get('website') || Date.now() - started < 3000) { show('fail', MSG.spam); return; }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      const endpoint = form.dataset.endpoint;
      try {
        if (endpoint) {
          const r = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
          if (!r.ok) throw new Error(String(r.status));
          show('ok', MSG.ok);
        } else {
          show('ok', MSG.preview);
        }
        form.reset();
        (window as any).gtag?.('event', 'generate_lead', { form: data.get('subject') });
      } catch {
        show('fail', MSG.fail);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
<style>
  .note { font-size: .88rem; margin: 0; }
  .cv { padding: 12px 16px; border-radius: 12px; background: var(--bg-soft); border: 1px solid var(--line); }
  fieldset.field { border: 0; padding: 0; margin: 0; }
</style>
