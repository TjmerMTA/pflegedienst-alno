---
// Bewerbungsformular. Варианты: karriere (Stellen/Jobs), ausbildung (Ausbildung, Praktikum, FSJ, Quereinstieg).
// Отправка и защита от спама — как в ContactForm: honeypot + минимальное время заполнения, fetch на SITE.formEndpoint;
// пустой endpoint = режим превью. Файлы (Lebenslauf) через статический endpoint не передаются — см. подсказку в форме.
import { SITE, getGlobal, getPage } from '../config/site';
interface Props { variant?: 'karriere' | 'ausbildung'; id?: string; position?: string }
const { variant = 'karriere', id = 'bewerbung', position } = Astro.props;
const subject = { karriere: 'Bewerbung Stelle', ausbildung: 'Bewerbung Ausbildung/Praktikum' }[variant];
// Тексты — в _global.json (группы forms и applicationForm); subject — тема письма, на сайте не виден
const g = getGlobal();
const f = (id: string) => g.text(`forms.${id}`);
const a = (id: string) => g.text(`applicationForm.${id}`);
const options = (id: string) => g.list<{ text: string }>(`applicationForm.${id}`).map((o) => o.text);
// Варианты Stelle и Wunsch должны совпадать с кнопками «Dafür bewerben» на страницах — берём из их списков
const positions = [...getPage('karriere').list<{ title: string }>('jobs.items').map((j) => j.title), a('initiative')];
const abschluss = options('schoolOptions');
const wunsch = getPage('ausbildung').list<{ tag: string }>('ways.items').map((w) => w.tag);
const jahr = new Date().getFullYear();
---
<form class="form" id={id} data-application-form data-endpoint={SITE.formEndpoint} novalidate>
  <input type="hidden" name="subject" value={`Website: ${subject}`} />
  <input type="hidden" name="from_page" value={Astro.url.pathname} />
  {variant === 'karriere' ? (
    <div class="field">
      <label for={`${id}-position`}>{a('positionLabel')} <span class="req">*</span></label>
      <select id={`${id}-position`} name="position" required>
        {positions.map((p) => <option value={p} selected={p === position}>{p}</option>)}
      </select>
      <span class="err" aria-live="polite"></span>
    </div>
  ) : (
    <fieldset class="seg field">
      <legend>{a('wishLegend')} </legend>
      {wunsch.map((v, i) => (
        <label><input type="radio" name="wunsch" value={v} checked={v === position || (!position && i === 0)} /><span>{v}</span></label>
      ))}
    </fieldset>
  )}
  <div class="row">
    <div class="field">
      <label for={`${id}-name`}>{f('nameLabel')} <span class="req">*</span></label>
      <input id={`${id}-name`} name="name" autocomplete="name" required minlength="2" />
      <span class="err" aria-live="polite"></span>
    </div>
    {variant === 'ausbildung' && (
      <div class="field">
        <label for={`${id}-jahr`}>{a('yearLabel')} <span class="req">*</span></label>
        <input id={`${id}-jahr`} name="geburtsjahr" type="number" inputmode="numeric" required min="1940" max={jahr - 14} placeholder={a('yearPlaceholder')} />
        <span class="err" aria-live="polite"></span>
      </div>
    )}
  </div>
  <div class="row">
    <div class="field">
      <label for={`${id}-phone`}>{f('phoneLabel')} <span class="req">*</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9 +\(\)\/\-]{6,}" />
      <span class="err" aria-live="polite"></span>
    </div>
    <div class="field">
      <label for={`${id}-email`}>{f('emailLabel')} <span class="req">*</span></label>
      <input id={`${id}-email`} name="email" type="email" autocomplete="email" required />
      <span class="err" aria-live="polite"></span>
    </div>
  </div>
  {variant === 'karriere' ? (
    <>
      <div class="field">
        <label for={`${id}-quali`}>{a('qualiLabel')} <span class="muted">{f('optional')}</span></label>
        <textarea id={`${id}-quali`} name="qualifikation" placeholder={a('qualiPlaceholder')}></textarea>
      </div>
      <div class="row">
        <div class="field">
          <label for={`${id}-start`}>{a('startLabel')} <span class="muted">{f('optional')}</span></label>
          <input id={`${id}-start`} name="eintritt" type="date" />
        </div>
      </div>
      <fieldset class="seg field">
        <legend>{a('hoursLegend')} </legend>
        {options('hoursOptions').map((v, i) => (
          <label><input type="radio" name="arbeitszeit" value={v} checked={i === 0} /><span>{v}</span></label>
        ))}
      </fieldset>
    </>
  ) : (
    <div class="row">
      <div class="field">
        <label for={`${id}-abschluss`}>{a('schoolLabel')} <span class="req">*</span></label>
        <select id={`${id}-abschluss`} name="schulabschluss" required>
          <option value="">{a('schoolPrompt')}</option>
          {abschluss.map((o) => <option value={o}>{o}</option>)}
        </select>
        <span class="err" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for={`${id}-start`}>{a('beginLabel')} <span class="muted">{f('optional')}</span></label>
        <input id={`${id}-start`} name="beginn" type="date" />
      </div>
    </div>
  )}
  <div class="field">
    <label for={`${id}-msg`}>{f('messageLabel')} <span class="muted">{f('optional')}</span></label>
    <textarea id={`${id}-msg`} name="message" placeholder={variant === 'karriere' ? a('messagePlaceholderJob') : a('messagePlaceholderTraining')}></textarea>
  </div>
  <p class="muted note cv">
    {a('cvBefore')} <a href={`mailto:${SITE.email}`}>{SITE.email}</a> {a('cvAfter')}
  </p>
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="consent"><input type="checkbox" name="datenschutz" required /> <span>{a('consentBefore')} <a href="/datenschutz/" target="_blank">{f('consentLink')}</a>. <span class="req">*</span></span></label>
  <button class="btn btn--primary" type="submit">{a('submit')}</button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="muted note">{a('note')}</p>
</form>
<script>
  // Сообщения — из _global.json, подставляются при сборке (src/lib/client-texts.mjs)
  declare const __APPLICATION_FORM_MSG__: Record<'required' | 'phone' | 'email' | 'year' | 'consent' | 'ok' | 'preview' | 'fail' | 'spam', string>;
  const MSG = __APPLICATION_FORM_MSG__;
  type Field = HTMLInputElement | HTMLSelectElement;
  document.querySelectorAll<HTMLFormElement>('[data-application-form]').forEach((form) => {
    const started = Date.now();
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const show = (cls: 'ok' | 'fail', text: string) => { status.className = `form-status ${cls}`; status.textContent = text; };
    const check = (el: Field) => {
      const err = el.closest('.field')?.querySelector<HTMLElement>('.err');
      let m = '';
      if (el.validity.valueMissing) m = MSG.required;
      else if (el.type === 'tel' && el.validity.patternMismatch) m = MSG.phone;
      else if (el.type === 'email' && el.validity.typeMismatch) m = MSG.email;
      else if (el.type === 'number' && (el.validity.rangeUnderflow || el.validity.rangeOverflow || el.validity.badInput)) m = MSG.year;
      el.setAttribute('aria-invalid', m ? 'true' : 'false');
      if (err) err.textContent = m;
      return !m;
    };
    const sel = 'input[required]:not([type=checkbox]), select[required]';
    form.querySelectorAll<Field>(sel).forEach((el) => el.addEventListener(el.tagName === 'SELECT' ? 'change' : 'blur', () => check(el)));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<Field>(sel)];
      const valid = fields.map(check).every(Boolean);
      const consent = form.querySelector<HTMLInputElement>('input[name=datenschutz]')!;
      if (!valid) { fields.find((f) => f.getAttribute('aria-invalid') === 'true')?.focus(); return; }
      if (!consent.checked) { show('fail', MSG.consent); consent.focus(); return; }
      const data = new FormData(form);
      if (data.get('website') || Date.now() - started < 3000) { show('fail', MSG.spam); return; }
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      const endpoint = form.dataset.endpoint;
      try {
        if (endpoint) {
          const r = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
          if (!r.ok) throw new Error(String(r.status));
          show('ok', MSG.ok);
        } else {
          show('ok', MSG.preview);
        }
        form.reset();
        (window as any).gtag?.('event', 'generate_lead', { form: data.get('subject') });
      } catch {
        show('fail', MSG.fail);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
<style>
  .note { font-size: .88rem; margin: 0; }
  .cv { padding: 12px 16px; border-radius: 12px; background: var(--bg-soft); border: 1px solid var(--line); }
  fieldset.field { border: 0; padding: 0; margin: 0; }
</style>
