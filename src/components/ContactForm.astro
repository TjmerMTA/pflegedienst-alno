---
// Форма заявки. Варианты: beratung (бесплатная консультация), rueckruf (обратный звонок),
// erstbegutachtung (запись на первичную оценку на дому), rechner (контакты из Pflege-Rechner, открывают результат),
// rechnertermin (запрос консультации из Pflege-Rechner). Для rechner-вариантов скрипт Rechner.astro кладёт результат расчёта
// в скрытое поле rechner_ergebnis; после успешной отправки форма шлёт событие lead-sent.
// Защита от спама: honeypot-поле + минимальное время заполнения. Отправка — fetch на SITE.formEndpoint.
import { SITE, getGlobal } from '../config/site';
interface Props { variant?: 'beratung' | 'rueckruf' | 'erstbegutachtung' | 'rechner' | 'rechnertermin'; id?: string }
const { variant = 'beratung', id = 'anfrage' } = Astro.props;
const subject = { beratung: 'Kostenlose Beratung', rueckruf: 'Rückruf-Anfrage', erstbegutachtung: 'Termin Erstbegutachtung', rechner: 'Pflege-Rechner (Kontaktdaten)', rechnertermin: 'Pflege-Rechner (Beratungstermin)' }[variant];
const isRechner = variant === 'rechner' || variant === 'rechnertermin';
// Тексты — в _global.json (группы forms и contactForm); subject — тема письма, на сайте не виден
const g = getGlobal();
const f = (id: string) => g.text(`forms.${id}`);
const c = (id: string) => g.text(`contactForm.${id}`);
const options = (id: string) => g.list<{ text: string }>(`contactForm.${id}`).map((o) => o.text);
const okText = isRechner ? c('okRechner') : undefined;
---
<form class="form" id={id} data-lead-form data-endpoint={SITE.formEndpoint} data-ok={okText} novalidate>
  <input type="hidden" name="subject" value={`Website: ${subject}`} />
  <input type="hidden" name="from_page" value={Astro.url.pathname} />
  {isRechner && <input type="hidden" name="rechner_ergebnis" value="" />}
  {variant !== 'rueckruf' && !isRechner && (
    <fieldset class="seg field">
      <legend>{c('topicLegend')} </legend>
      {options('topics').map((v, i, all) => (
        <label><input type="radio" name="leistung" value={v} checked={i === all.length - 1} /><span>{v}</span></label>
      ))}
    </fieldset>
  )}
  <div class="row">
    <div class="field">
      <label for={`${id}-name`}>{f('nameLabel')} <span class="req">*</span></label>
      <input id={`${id}-name`} name="name" autocomplete="name" required minlength="2" />
      <span class="err" aria-live="polite"></span>
    </div>
    <div class="field">
      <label for={`${id}-phone`}>{f('phoneLabel')} <span class="req">*</span></label>
      <input id={`${id}-phone`} name="phone" type="tel" autocomplete="tel" inputmode="tel" required pattern="[0-9 +\(\)\/\-]{6,}" />
      <span class="err" aria-live="polite"></span>
    </div>
  </div>
  {variant === 'rechnertermin' && (
    <div class="row">
      <div class="field">
        <label for={`${id}-datum`}>{c('dateLabel')}</label>
        <input id={`${id}-datum`} name="wunschtermin" type="date" />
      </div>
      <div class="field">
        <label for={`${id}-zeit`}>{c('timeLabel')}</label>
        <select id={`${id}-zeit`} name="tageszeit">
          {options('timeOptions').map((o) => <option>{o}</option>)}
        </select>
      </div>
    </div>
  )}
  {variant === 'erstbegutachtung' && (
    <div class="row">
      <div class="field">
        <label for={`${id}-stadtteil`}>{c('placeLabel')} <span class="req">*</span></label>
        <input id={`${id}-stadtteil`} name="stadtteil" required placeholder={c('placePlaceholder')} />
        <span class="err" aria-live="polite"></span>
      </div>
      <div class="field">
        <label for={`${id}-datum`}>{c('dateLabel')}</label>
        <input id={`${id}-datum`} name="wunschtermin" type="date" />
      </div>
      <div class="field">
        <label for={`${id}-zeit`}>{c('timeLabel')}</label>
        <select id={`${id}-zeit`} name="tageszeit">
          {options('timeOptions').map((o) => <option>{o}</option>)}
        </select>
      </div>
      <div class="field">
        <label for={`${id}-pg`}>{c('careLevelLabel')}</label>
        <select id={`${id}-pg`} name="pflegegrad">
          {options('careLevelOptions').map((o) => <option>{o}</option>)}
        </select>
      </div>
    </div>
  )}
  {variant === 'rueckruf' ? (
    <div class="field">
      <label for={`${id}-zeit`}>{c('callbackLabel')}</label>
      <select id={`${id}-zeit`} name="rueckrufzeit">{options('callbackOptions').map((o) => <option>{o}</option>)}</select>
    </div>
  ) : variant === 'rechnertermin' ? null : (
    <div class="row">
      <div class="field">
        <label for={`${id}-email`}>{f('emailLabel')} <span class="muted">{f('optional')}</span></label>
        <input id={`${id}-email`} name="email" type="email" autocomplete="email" />
        <span class="err" aria-live="polite"></span>
      </div>
    </div>
  )}
  {variant !== 'rueckruf' && !isRechner && (
    <div class="field">
      <label for={`${id}-msg`}>{f('messageLabel')} <span class="muted">{f('optional')}</span></label>
      <textarea id={`${id}-msg`} name="message" placeholder={c('messagePlaceholder')}></textarea>
    </div>
  )}
  <div class="hp" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
  <label class="consent"><input type="checkbox" name="datenschutz" required /> <span>{c('consentBefore')} <a href="/datenschutz/" target="_blank">{f('consentLink')}</a>. <span class="req">*</span></span></label>
  <button class="btn btn--primary" type="submit">{{ rueckruf: c('submitRueckruf'), erstbegutachtung: c('submitTermin'), rechner: c('submitRechner'), rechnertermin: c('submitRechnerTermin') }[variant] ?? c('submitBeratung')}</button>
  <p class="form-status" role="status" aria-live="polite"></p>
  <p class="muted note">{c('note')}</p>
</form>
<script>
  // Сообщения — из _global.json, подставляются при сборке (src/lib/client-texts.mjs)
  declare const __CONTACT_FORM_MSG__: Record<'required' | 'phone' | 'email' | 'consent' | 'ok' | 'preview' | 'fail' | 'spam', string>;
  const MSG = __CONTACT_FORM_MSG__;
  document.querySelectorAll<HTMLFormElement>('[data-lead-form]').forEach((form) => {
    const started = Date.now();
    const status = form.querySelector<HTMLElement>('.form-status')!;
    const show = (cls: 'ok' | 'fail', text: string) => { status.className = `form-status ${cls}`; status.textContent = text; };
    const check = (el: HTMLInputElement) => {
      const err = el.closest('.field')?.querySelector<HTMLElement>('.err');
      let m = '';
      if (el.validity.valueMissing) m = MSG.required;
      else if (el.type === 'tel' && el.validity.patternMismatch) m = MSG.phone;
      else if (el.type === 'email' && el.validity.typeMismatch) m = MSG.email;
      el.setAttribute('aria-invalid', m ? 'true' : 'false');
      if (err) err.textContent = m;
      return !m;
    };
    form.querySelectorAll<HTMLInputElement>('input[required]:not([type=checkbox]), input[type=email]').forEach((el) => el.addEventListener('blur', () => check(el)));
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const fields = [...form.querySelectorAll<HTMLInputElement>('input[required]:not([type=checkbox]), input[type=email]')];
      const valid = fields.map(check).every(Boolean);
      const consent = form.querySelector<HTMLInputElement>('input[name=datenschutz]')!;
      if (!valid) { fields.find((f) => f.getAttribute('aria-invalid') === 'true')?.focus(); return; }
      if (!consent.checked) { show('fail', MSG.consent); consent.focus(); return; }
      const data = new FormData(form);
      if (data.get('website') || Date.now() - started < 3000) { show('fail', MSG.spam); return; }
      data.set('fill_ms', String(Date.now() - started)); // второй раз время проверит сервер
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      btn.disabled = true;
      const endpoint = form.dataset.endpoint;
      try {
        if (endpoint) {
          const r = await fetch(endpoint, { method: 'POST', headers: { Accept: 'application/json' }, body: data });
          if (!r.ok) throw new Error(String(r.status));
          show('ok', form.dataset.ok || MSG.ok);
        } else {
          show('ok', MSG.preview);
        }
        form.reset();
        (window as any).gtag?.('event', 'generate_lead', { form: data.get('subject') });
        form.dispatchEvent(new CustomEvent('lead-sent', { bubbles: true }));
      } catch {
        show('fail', MSG.fail);
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
<style>
  .note { font-size: .88rem; margin: 0; }
  fieldset.field { border: 0; padding: 0; margin: 0; }
</style>
