---
import { Image } from 'astro:assets';
import { getGlobal } from '../config/site';
interface Props { light?: boolean }
const { light = false } = Astro.props;
const g = getGlobal();
const mark = g.img('brand.logoImage')!;
const suffix = g.text('brand.logoSuffix');
---
<a href="/" class:list={['logo', { light }]} aria-label={`${g.text('contact.name')} – ${g.text('header.crumbHome')}`}>
  <Image src={mark.src} alt={mark.alt} width={48} height={48} loading="eager" />
  <span><b>{g.text('brand.logoLine1')}</b><em>{g.text('brand.logoLine2')} {suffix && <small>{suffix}</small>}</em></span>
</a>
<style>
  .logo { flex: none; display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: #13a9bd; }
  .logo img { inline-size: 48px; block-size: 48px; max-width: none; object-fit: contain; }
  .logo span { display: grid; line-height: 1.02; white-space: nowrap; }
  .logo b { font-weight: 600; font-size: 1.12rem; letter-spacing: -.01em; }
  .logo em { font-style: normal; font-weight: 800; font-size: 1.28rem; letter-spacing: .01em; }
  .logo small { font-size: .8em; font-weight: 600; }
  .logo.light { color: #fff; }
</style>
