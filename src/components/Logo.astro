---
import { Image } from 'astro:assets';
import mark from '../assets/img/logo-mark.png';
interface Props { light?: boolean }
const { light = false } = Astro.props;
---
<a href="/" class:list={['logo', { light }]} aria-label="Pflegedienst ALNO GmbH – Startseite">
  <Image src={mark} alt="" width={48} height={48} loading="eager" />
  <span><b>Pflegedienst</b><em>ALNO <small>GmbH</small></em></span>
</a>
<style>
  .logo { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; color: #13a9bd; }
  .logo img { inline-size: 48px; block-size: 48px; }
  .logo span { display: grid; line-height: 1.02; white-space: nowrap; }
  .logo b { font-weight: 600; font-size: 1.12rem; letter-spacing: -.01em; }
  .logo em { font-style: normal; font-weight: 800; font-size: 1.28rem; letter-spacing: .01em; }
  .logo small { font-size: .8em; font-weight: 600; }
  .logo.light { color: #fff; }
</style>
