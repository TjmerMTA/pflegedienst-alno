---
import Icon from './Icon.astro';
// TODO: заменить на сканы реальных документов / печати (Versorgungsvertrag, MD-Prüfbericht и т. д.)
// Пункты — в _global.json (группа certificates). Импорт динамический: новый статический import
// сдвинул бы порядок <style> в собранных страницах (Astro сортирует CSS по позиции импорта)
const { getGlobal } = await import('../lib/content');
const items = getGlobal().list<{ icon: string; title: string; text: string }>('certificates.items');
---
<ul class="certs">
  {items.map((c) => (
    <li><span class="ico ico--green"><Icon name={c.icon} /></span><span><b>{c.title}</b><small>{c.text}</small></span></li>
  ))}
</ul>
<style>
  .certs { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 250px), 1fr)); }
  li { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 16px; padding: 16px 18px; }
  li .ico { margin: 0; inline-size: 48px; block-size: 48px; }
  li span:last-child { display: grid; line-height: 1.35; }
  small { color: var(--muted); font-size: .88rem; }
</style>
