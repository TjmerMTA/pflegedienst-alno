---
// Pflege-Rechner: Pflegeleistungen (3 Schritte) + Entlastungsbetrag. Daten und Rechenregeln: src/config/rechner.ts.
// Limit: 2 kostenlose Berechnungen pro Gerät (localStorage). Bei der 3. öffnet sich ein Dialog: Kontaktdaten (ContactForm
// variant="rechner") oder Beratungstermin (variant="rechnertermin") – danach wird das Ergebnis gezeigt und das Gerät freigeschaltet.
import ContactForm from './ContactForm.astro';
import Icon from './Icon.astro';
// Тексты — в src/content/pages/pflege-rechner.json. Разметка читает их здесь, скрипт ниже получает при сборке:
// __T/__H/__N — макросы из src/lib/client-texts.mjs. Импорт динамический: новый статический сдвинул бы порядок <style>
const { getPage } = await import('../lib/content');
const p = getPage('pflege-rechner');
---
<div class="rc" id="rc">
  <div class="tabs" role="tablist" aria-label="Rechner wählen">
    <button class="tab" role="tab" id="tab-btn-plan" aria-controls="tab-plan" aria-selected="true" data-tab="plan"><span data-i="heart"></span>{p.text('tabs.plan')}</button>
    <button class="tab" role="tab" id="tab-btn-ent" aria-controls="tab-ent" aria-selected="false" data-tab="ent" tabindex="-1"><span data-i="shield"></span>{p.text('tabs.ent')}</button>
  </div>

  <!-- ================= TAB 1 ================= -->
  <section id="tab-plan" role="tabpanel" aria-labelledby="tab-btn-plan">
    <div class="stepper" aria-hidden="true">
      <div class="track"></div><div class="fill" id="fill"></div>
      <div class="sd on" data-sd="1"><div class="b" data-i="user"></div>{p.text('stepper.grad')}</div>
      <div class="sd" data-sd="2"><div class="b" data-i="calendar"></div>{p.text('stepper.plan')}</div>
      <div class="sd" data-sd="3"><div class="b" data-i="chart"></div>{p.text('stepper.ergebnis')}</div>
    </div>

    <!-- Schritt 1 -->
    <div id="step1" class="step">
      <div class="card panel">
        <h2>{p.text('modus.title')}</h2>
        <p class="muted">{p.text('modus.sub')}</p>
        <div class="modes" id="modes"></div>
        <div class="rnote" id="mode-info"></div>
      </div>

      <div class="card panel">
        <h2>{p.text('grad.title')}</h2>
        <p class="muted">{p.text('grad.sub')}</p>
        <div class="pgs" id="pgs"></div>

        <div class="rnote warn hidden" id="pg1-alert">
          <span data-i="info"></span>
          <div><Fragment set:html={p.html('grad.pg1Alert').replace('{betrag}', '<span data-eb></span>')} />
          <div class="rnote-act"><button class="btn btn--primary btn--sm" type="button" data-goto-ent><span data-i="shield"></span>{p.text('grad.pg1Button')}</button></div></div>
        </div>

        <div id="budget-box" class="hidden">
          <h3><span data-i="wallet"></span>{p.text('grad.budgetTitle')}</h3>
          <div class="kpis">
            <div class="kpi"><div class="ki" data-i="home"></div><div><div class="l">{p.text('grad.kpiSach')}</div><div class="v" id="b-sach">–</div></div></div>
            <div class="kpi good"><div class="ki" data-i="euro"></div><div><div class="l">{p.text('grad.kpiGeld')}</div><div class="v" id="b-geld">–</div></div></div>
            <div class="kpi"><div class="ki" data-i="shield"></div><div><div class="l">{p.text('grad.kpiEnt')}</div><div class="v" id="b-ent">–</div></div></div>
          </div>
        </div>
      </div>

      <div class="navrow"><span></span><button class="btn btn--primary" type="button" id="to2" disabled>{p.text('grad.next')}<span data-i="arrowR"></span></button></div>
    </div>

    <!-- Schritt 2 -->
    <div id="step2" class="step hidden">
      <div class="rnote warn hidden" id="geld-hint"><span data-i="info"></span><div set:html={p.html('plan.geldHint')} /></div>

      <div class="card panel">
        <h2>{p.text('plan.title')}</h2>
        <p class="muted">{p.text('plan.sub')}</p>
        <div class="search"><span data-i="search"></span><input id="q" type="search" placeholder={p.text('plan.search')} autocomplete="off" aria-label="Leistung suchen" /></div>
        <div class="chips" id="chips"></div>
        <div class="svc-list" id="svc-list"></div>

        <div id="sched" class="sched hidden"></div>
      </div>

      <div class="card panel">
        <h3 class="h3-first"><span data-i="list"></span>{p.text('planliste.title')}</h3>
        <div class="plan" id="plan"></div>
      </div>

      <div class="budget-bar" id="budget-bar">
        <div class="bb-top"><span id="bb-l"></span><span id="bb-r"></span></div>
        <div class="bar"><i id="bb-fill"></i></div>
      </div>

      <div class="navrow"><button class="btn btn--ghost" type="button" id="back1"><span data-i="arrowL"></span>{p.text('planliste.back')}</button><button class="btn btn--primary" type="button" id="to3">{p.text('planliste.next')}<span data-i="arrowR"></span></button></div>
    </div>

    <!-- Schritt 3 -->
    <div id="step3" class="step hidden">
      <div class="card panel">
        <h2 tabindex="-1" id="res-h">{p.text('ergebnis.title')}</h2>
        <p class="muted" id="res-sub"></p>
        <div class="res-top">
          <div class="ring-wrap">
            <svg viewBox="0 0 120 120" aria-hidden="true"><circle class="c-bg" cx="60" cy="60" r="50" fill="none" stroke-width="12"/><circle class="c-fg" id="ring" cx="60" cy="60" r="50" fill="none" stroke-width="12" stroke-linecap="round" stroke-dasharray="314.16" stroke-dashoffset="314.16"/></svg>
            <div class="ring-center"><b id="ring-pct">0 %</b><small id="ring-lbl" set:html={p.textHtml('ergebnis.ringUsed').replace('\u00AD', '&shy;')} /></div>
          </div>
          <div>
            <div class="big good" id="big-pay"><div class="ki" data-i="euro"></div><div><div class="l" id="pay-l">{p.text('ergebnis.payPlain')}</div><div class="v" id="r-payout">0 €</div></div></div>
            <div class="big" id="big-own"><div class="ki" id="own-ic"></div><div><div class="l">{p.text('ergebnis.own')}</div><div class="v" id="r-own">0 €</div></div></div>
          </div>
        </div>
        <table class="breakdown" id="breakdown"></table>
        <div class="rnote" id="r-explain"><span data-i="sparkle"></span><div></div></div>
        <div class="cta-box">
          <div><b>{p.text('ergebnis.ctaTitle')}</b><div class="muted">{p.text('ergebnis.ctaText')}</div></div>
          <a class="btn btn--green" href="/erstbegutachtung/"><Icon name="calendar" size={20} /> {p.text('ergebnis.ctaButton')}</a>
        </div>
        <p class="muted free-left" id="free-left" hidden></p>
      </div>
      <div class="navrow">
        <button class="btn btn--ghost" type="button" id="back2"><span data-i="arrowL"></span>{p.text('ergebnis.back')}</button>
        <span class="navrow-r">
          <button class="btn btn--ghost" type="button" id="print"><span data-i="print"></span>{p.text('ergebnis.print')}</button>
          <button class="btn btn--ghost" type="button" id="restart"><span data-i="refresh"></span>{p.text('ergebnis.restart')}</button>
        </span>
      </div>
    </div>
  </section>

  <!-- ================= TAB 2 ================= -->
  <section id="tab-ent" class="hidden step" role="tabpanel" aria-labelledby="tab-btn-ent">
    <div class="card panel">
      <h2>{p.text('ent.title')}</h2>
      <p class="muted">{p.text('ent.textBefore')} <b data-eb></b> {p.text('ent.textAfter')}</p>

      <label class="flabel" for="e-budget"><span data-i="wallet"></span>{p.text('ent.budgetLabel')}</label>
      <input class="num-in" type="number" id="e-budget" min="0" step="1" inputmode="decimal" />
      <p class="muted hint">{p.text('ent.budgetHint')}</p>

      <label class="flabel" for="e-hours"><span data-i="clock"></span>{p.text('ent.hoursLabel')}</label>
      <div class="slider-row">
        <input type="range" id="e-hours" min="0" max="20" step="0.5" value="2" />
        <div class="hours-out" id="e-hours-out" aria-live="polite">2 {p.text('ent.hoursUnit')}</div>
      </div>
      <p class="muted hint">{p.text('ent.rateLabel')} <b id="e-rate"></b></p>

      <div class="kpis kpis--top">
        <div class="kpi"><div class="ki" data-i="receipt"></div><div><div class="l">{p.text('ent.kpiCost')}</div><div class="v" id="e-cost">–</div></div></div>
        <div class="kpi good"><div class="ki" data-i="check"></div><div><div class="l">{p.text('ent.kpiCovered')}</div><div class="v" id="e-cov">–</div></div></div>
        <div class="kpi" id="e-own-k"><div class="ki" data-i="euro"></div><div><div class="l">{p.text('ent.kpiOwn')}</div><div class="v" id="e-own">–</div></div></div>
      </div>
      <div class="bar bar--top"><i id="e-bar"></i></div>
      <div class="rnote good" id="e-max"><span data-i="sparkle"></span><div></div></div>
    </div>

    <div class="facts">
      {p.list<{ icon: string; title: string; text: string }>('ent.facts').map((f) => <div class="fact"><div class="ki" data-i={f.icon}></div><div><b>{f.title}</b><span>{f.text}</span></div></div>)}
    </div>
    <div class="cta-box cta-box--solo">
      <div><b>{p.text('ent.ctaTitle')}</b><div class="muted">{p.text('ent.ctaText')}</div></div>
      <a class="btn btn--green" href="/erstbegutachtung/"><Icon name="calendar" size={20} /> {p.text('ent.ctaButton')}</a>
    </div>
  </section>

  <p class="foot"><span data-i="info"></span><span id="foot"></span></p>
</div>

<div class="toast" id="toast" role="status" aria-live="polite"><span data-i="check"></span><span id="toast-t"></span></div>

<!-- Dialog ab der 3. Berechnung -->
<dialog class="rdlg" id="gate" aria-labelledby="gate-h">
  <button class="rdlg-x" type="button" id="gate-x" aria-label="Schließen"><span data-i="close"></span></button>
  <div class="rdlg-in">
    <span class="eyebrow">{p.text('gate.eyebrow')}</span>
    <h2 id="gate-h" tabindex="-1">{p.text('gate.title')}</h2>
    <p class="lead">{p.text('gate.lead')}</p>

    <div class="rdlg-opts" role="group" aria-label="Zwei Möglichkeiten">
      <button class="opt" type="button" data-opt="kontakt" aria-pressed="true" aria-controls="opt-kontakt"><span data-i="user"></span><b>{p.text('gate.kontaktTitle')}</b><small>{p.text('gate.kontaktSub')}</small></button>
      <button class="opt" type="button" data-opt="termin" aria-pressed="false" aria-controls="opt-termin"><span data-i="calendar"></span><b>{p.text('gate.terminTitle')}</b><small>{p.text('gate.terminSub')}</small></button>
    </div>

    <div id="opt-kontakt" class="opt-panel">
      <ContactForm variant="rechner" id="rc-kontakt" />
    </div>
    <div id="opt-termin" class="opt-panel" hidden>
      <p class="muted opt-intro">{p.text('gate.terminIntro')}</p>
      <ContactForm variant="rechnertermin" id="rc-termin" />
      <p class="muted opt-alt">{p.text('gate.altBefore')} <a href="/erstbegutachtung/" target="_blank" rel="noopener">{p.text('gate.altLink')}</a></p>
    </div>
  </div>
</dialog>

<script>
  import { RECHNER as CONFIG, LEISTUNGEN, calc as calcPlan, monthly, oneoffSum, unitPrice as unitOf, type PlanItem, type Mode } from '../config/rechner';
  // Макросы сборки (src/lib/client-texts.mjs): __T — для textContent, __H — для innerHTML
  declare function __T(path: string, parts?: Record<string, unknown>): string;
  declare function __H(path: string, parts?: Record<string, unknown>): string;

  /* ---------- Icons (schlichte Linien-Icons) ---------- */
  const ICONS: Record<string, string> = {
    heart:'<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"/>',
    shield:'<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/>',
    user:'<circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/>',
    users:'<circle cx="9" cy="8" r="3"/><path d="M3 20a6 6 0 0 1 12 0"/><circle cx="17" cy="9" r="2.5"/><path d="M16 14.2A5 5 0 0 1 21 19"/>',
    calendar:'<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>',
    chart:'<path d="M12 3a9 9 0 1 0 9 9h-9z"/><path d="M15 3.5A9 9 0 0 1 20.5 9H15z"/>',
    wallet:'<path d="M3 7a2 2 0 0 1 2-2h12v4"/><path d="M3 7v11a2 2 0 0 0 2 2h15V9H5a2 2 0 0 1-2-2z"/><circle cx="16" cy="14.5" r="1.2"/>',
    combo:'<circle cx="9" cy="12" r="6"/><circle cx="15" cy="12" r="6"/>',
    home:'<path d="M3 11l9-7 9 7"/><path d="M5 10v10h14V10"/><path d="M10 20v-6h4v6"/>',
    euro:'<path d="M17 6.5A6.5 6.5 0 0 0 7 12a6.5 6.5 0 0 0 10 5.5M4 10h9M4 14h9"/>',
    info:'<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
    arrowR:'<path d="M5 12h14M13 6l6 6-6 6"/>',
    arrowL:'<path d="M19 12H5M11 6l-6 6 6 6"/>',
    search:'<circle cx="11" cy="11" r="7"/><path d="M20 20l-3.5-3.5"/>',
    list:'<path d="M9 6h11M9 12h11M9 18h11"/><circle cx="4.5" cy="6" r="1"/><circle cx="4.5" cy="12" r="1"/><circle cx="4.5" cy="18" r="1"/>',
    plus:'<path d="M12 5v14M5 12h14"/>',
    trash:'<path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/>',
    check:'<path d="M5 12l5 5L20 7"/>',
    close:'<path d="M6 6l12 12M18 6L6 18"/>',
    sparkle:'<path d="M12 3l1.8 4.7 4.7 1.8-4.7 1.8L12 16l-1.8-4.7L5.5 9.5l4.7-1.8z"/><path d="M19 15l.7 1.8 1.8.7-1.8.7L19 20l-.7-1.8-1.8-.7 1.8-.7z"/>',
    refresh:'<path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 5v6h-6"/>',
    print:'<path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/>',
    clock:'<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
    receipt:'<path d="M5 3h14v18l-3-2-2 2-2-2-2 2-2-2-3 2z"/><path d="M9 8h6M9 12h6"/>',
    piggy:'<path d="M5 11a7 6 0 0 1 12.5-3.5L20 7v4l1 1v3h-2.5a7 6 0 0 1-2.5 2V20h-3v-2h-3v2H7v-3.2A6 6 0 0 1 5 11z"/><path d="M15 10h.01"/>',
    drop:'<path d="M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11z"/>',
    food:'<path d="M4 12h16a8 8 0 0 1-16 0z"/><path d="M9 4c0 2 1 2 1 4M14 4c0 2 1 2 1 4"/>',
    move:'<circle cx="13" cy="4.5" r="2"/><path d="M9 21l2.5-7 2.5 2.5V21M8 11.5l3-3 3 2.5 3 1"/>',
    broom:'<path d="M14 3l7 7M11 6l7 7-5 2-6-6z"/><path d="M7 9l-4 9 3 3 9-4"/>',
    hand:'<path d="M8 13V5.5a1.5 1.5 0 0 1 3 0V11M11 10V4.5a1.5 1.5 0 0 1 3 0V11M14 10.5V6a1.5 1.5 0 0 1 3 0v7a7 7 0 0 1-7 7h-.5a6 6 0 0 1-4.6-2.2L3 15.5a1.5 1.5 0 0 1 2.3-2L8 16"/>',
    chat:'<path d="M4 5h16v11H9l-5 4z"/><path d="M8 9h8M8 12h5"/>',
    sunrise:'<path d="M3 19h18M7 19a5 5 0 0 1 10 0M12 4v5M9 6l3-3 3 3M4.5 12l1.4 1.4M19.5 12l-1.4 1.4"/>',
    sun:'<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M5 5l1.4 1.4M17.6 17.6L19 19M5 19l1.4-1.4M17.6 6.4L19 5"/>',
    sunset:'<path d="M3 19h18M7 19a5 5 0 0 1 10 0M12 3v6M9 6l3 3 3-3M4.5 12l1.4 1.4M19.5 12l-1.4 1.4"/>',
    moon:'<path d="M20 14.5A8 8 0 1 1 9.5 4a6.5 6.5 0 0 0 10.5 10.5z"/>',
    once:'<circle cx="12" cy="12" r="9"/><path d="M11 9l2-1v8"/>',
    alert:'<path d="M12 3l10 18H2z"/><path d="M12 10v4M12 17h.01"/>',
    smile:'<circle cx="12" cy="12" r="9"/><path d="M8.5 14a4 4 0 0 0 7 0M9 9.5h.01M15 9.5h.01"/>',
  };
  const ic = (n: string, cls = '') => `<svg class="i ${cls}" viewBox="0 0 24 24" aria-hidden="true">${ICONS[n] || ''}</svg>`;
  document.querySelectorAll<HTMLElement>('[data-i]').forEach((el) => el.insertAdjacentHTML('afterbegin', ic(el.dataset.i!)));

  const CATS: Record<string, { label: string; icon: string; fg: string; bg: string }> = {
    alle:      { label: __H('kategorien.alle'), icon: 'sparkle', fg: '#047d8c', bg: '#e9f7f9' },
    pakete:    { label: __H('kategorien.pakete'), icon: 'heart',   fg: '#c2416b', bg: '#fce8ef' },
    koerper:   { label: __H('kategorien.koerper'), icon: 'drop',    fg: '#0e8fb3', bg: '#e2f4fa' },
    essen:     { label: __H('kategorien.essen'), icon: 'food',    fg: '#b05f0e', bg: '#fdf0e1' },
    mobil:     { label: __H('kategorien.mobil'), icon: 'move',    fg: '#6d4fc2', bg: '#efeafb' },
    hilfe:     { label: __H('kategorien.hilfe'), icon: 'hand',    fg: '#2e7d1a', bg: '#eefae8' },
    haus:      { label: __H('kategorien.haus'), icon: 'broom',   fg: '#8a5f10', bg: '#f8f0dc' },
    betreuung: { label: __H('kategorien.betreuung'), icon: 'users',   fg: '#2f7d8c', bg: '#e2f2f4' },
    beratung:  { label: __H('kategorien.beratung'), icon: 'chat',    fg: '#4c5f6b', bg: '#edf1f5' },
  };
  const catIcon = (c: string) => { const k = CATS[c] || CATS.alle; return `<div class="ci" style="background:${k.bg};color:${k.fg}">${ic(k.icon)}</div>`; };

  /* ---------- Helpers ---------- */
  const WPM = CONFIG.wochenProMonat;
  const DAYS = [__H('zeitplan.mo'), __H('zeitplan.di'), __H('zeitplan.mi'), __H('zeitplan.do'), __H('zeitplan.fr'), __H('zeitplan.sa'), __H('zeitplan.so')];
  const SLOTS = [{ n: __H('zeitplan.morgens'), i: 'sunrise' }, { n: __H('zeitplan.mittags'), i: 'sun' }, { n: __H('zeitplan.nachmittags'), i: 'sunset' }, { n: __H('zeitplan.abends'), i: 'moon' }];
  const PG_LABEL: Record<number, string> = { 1: __H('grad.label1'), 2: __H('grad.label2'), 3: __H('grad.label3'), 4: __H('grad.label4'), 5: __H('grad.label5') };
  const $ = (s: string) => document.querySelector<any>(s)!;
  const $$ = (s: string) => [...document.querySelectorAll<any>(s)];
  const eur = (v: number) => (Math.round(v * 100) / 100).toLocaleString('de-DE', { style: 'currency', currency: 'EUR' });
  const esc = (s: unknown) => String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  const splitName = (n: string) => { const m = n.match(/^(L\d+a?)\s+(.*)$/); return m ? { code: m[1], text: m[2] } : { code: '', text: n }; };
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  function countTo(el: any, to: number, fmt: (v: number) => string = eur) {
    const from = el._v || 0; el._v = to;
    if (reduce) { el.textContent = fmt(to); return; }
    const t0 = performance.now(), d = 650;
    const step = (t: number) => { const p = Math.min(1, (t - t0) / d), e = 1 - Math.pow(1 - p, 3);
      el.textContent = fmt(from + (to - from) * e); if (p < 1) requestAnimationFrame(step); };
    requestAnimationFrame(step);
  }
  let toastT: number;
  function toast(msg: string) { $('#toast-t').textContent = msg; $('#toast').classList.add('show'); clearTimeout(toastT); toastT = window.setTimeout(() => $('#toast').classList.remove('show'), 3600); }

  const state = { mode: 'kombi' as Mode, pg: null as number | null, plan: [] as PlanItem[], sel: null as string | null, slots: new Set<string>(), dur: 30, cat: 'alle', q: '' };

  /* ---------- Tabs ---------- */
  function showTab(t: string) {
    $$('.tab').forEach((b) => { const on = b.dataset.tab === t; b.setAttribute('aria-selected', String(on)); b.tabIndex = on ? 0 : -1; });
    $('#tab-plan').classList.toggle('hidden', t !== 'plan');
    $('#tab-ent').classList.toggle('hidden', t !== 'ent');
  }
  $$('.tab').forEach((b) => {
    b.onclick = () => showTab(b.dataset.tab);
    b.onkeydown = (e: KeyboardEvent) => { if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') { const o = $$('.tab').find((x) => x !== b)!; showTab(o.dataset.tab); o.focus(); } };
  });
  $$('[data-goto-ent]').forEach((b) => (b.onclick = () => showTab('ent')));
  $$('[data-eb]').forEach((e) => (e.textContent = eur(CONFIG.entlastung)));

  /* ---------- Schritt 1 ---------- */
  const MODES = [
    { id: 'geld', icon: 'wallet', t: __H('modus.geldTitle'), s: __H('modus.geldSub'),
      info: `<b>${__H('modus.geldInfoTitle')}</b> ${__H('modus.geldInfo')}` },
    { id: 'kombi', icon: 'combo', t: __H('modus.kombiTitle'), s: __H('modus.kombiSub'), badge: __H('modus.kombiBadge'),
      info: `<b>${__H('modus.kombiInfoTitle')}</b> ${__H('modus.kombiInfo')}` },
    { id: 'sach', icon: 'home', t: __H('modus.sachTitle'), s: __H('modus.sachSub'),
      info: `<b>${__H('modus.sachInfoTitle')}</b> ${__H('modus.sachInfo')}` },
  ];
  $('#modes').innerHTML = MODES.map((m) => `<button class="mode" type="button" data-mode="${m.id}" aria-pressed="false">
    <span class="tick">${ic('check')}</span><div class="mi">${ic(m.icon)}</div><b>${m.t}</b><small>${m.s}</small>${m.badge ? `<div><span class="badge">${m.badge}</span></div>` : ''}</button>`).join('');
  $$('.mode').forEach((b) => (b.onclick = () => { state.mode = b.dataset.mode; renderModes(); }));
  function renderModes() {
    $$('.mode').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.mode === state.mode)));
    $('#mode-info').innerHTML = ic('info') + `<div>${MODES.find((m) => m.id === state.mode)!.info}</div>`;
  }

  $('#pgs').innerHTML = [1, 2, 3, 4, 5].map((n) => `<button class="pg" type="button" data-pg="${n}" aria-pressed="false" aria-label="Pflegegrad ${n}">
    <span class="n">${n}</span><span class="bars">${[1, 2, 3, 4, 5].map((k) => `<i class="${k <= n ? 'f' : ''}" style="height:${4 + k * 2.4}px"></i>`).join('')}</span><span class="lbl">${PG_LABEL[n]}</span></button>`).join('');
  $$('.pg').forEach((b) => (b.onclick = () => { state.pg = +b.dataset.pg; renderStep1(); }));
  function renderStep1() {
    const pg = state.pg;
    $$('.pg').forEach((b) => b.setAttribute('aria-pressed', String(+b.dataset.pg === pg)));
    $('#pg1-alert').classList.toggle('hidden', pg !== 1);
    $('#budget-box').classList.toggle('hidden', !pg || pg === 1);
    if (pg && pg > 1) { countTo($('#b-sach'), CONFIG.sachleistung[pg]); countTo($('#b-geld'), CONFIG.pflegegeld[pg]); countTo($('#b-ent'), CONFIG.entlastung); }
    $('#to2').disabled = !pg || pg === 1;
  }

  /* ---------- Limit: 2 kostenlose Berechnungen pro Gerät ---------- */
  const FREE = 2, K_COUNT = 'alno-rechner-n', K_OK = 'alno-rechner-ok';
  const lsGet = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const lsSet = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch { /* Speicher gesperrt – dann gilt kein Limit */ } };
  const storageOk = () => { try { localStorage.setItem('_rc', '1'); localStorage.removeItem('_rc'); return true; } catch { return false; } };
  const unlocked = () => !storageOk() || lsGet(K_OK) === '1';
  /** true = Ergebnis darf gezeigt werden (und die Berechnung wird gezählt) */
  function consume() {
    if (unlocked()) return true;
    const n = +(lsGet(K_COUNT) || 0);
    if (n >= FREE) return false;
    lsSet(K_COUNT, String(n + 1));
    return true;
  }
  function renderFreeLeft() {
    const el = $('#free-left');
    if (unlocked()) { el.hidden = true; return; }
    const n = Math.min(FREE, +(lsGet(K_COUNT) || 0));
    el.hidden = false;
    el.textContent = n >= FREE ? __T('ergebnis.freeUsed') : __T('ergebnis.freeCount', { n, max: FREE });
  }

  /* ---------- Navigation ---------- */
  function goStep(n: number) {
    [1, 2, 3].forEach((i) => { const el = $('#step' + i); el.classList.toggle('hidden', i !== n); if (i === n) { el.classList.remove('step'); void el.offsetWidth; el.classList.add('step'); } });
    $$('.sd').forEach((d) => { const k = +d.dataset.sd; d.classList.toggle('on', k === n); d.classList.toggle('done', k < n); });
    $('#fill').style.width = `calc(${(n - 1) * 50}% - ${(n - 1) * 22}px)`;
    if (n === 2) { $('#geld-hint').classList.toggle('hidden', state.mode !== 'geld'); renderBudgetBar(); }
    if (n === 3) { renderResult(); renderFreeLeft(); }
    $('#rc').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
  }
  $('#to2').onclick = () => goStep(2);
  $('#back1').onclick = () => goStep(1);
  $('#to3').onclick = () => { if (consume()) goStep(3); else openGate(); };
  $('#back2').onclick = () => goStep(2);
  $('#print').onclick = () => window.print();
  $('#restart').onclick = () => { state.plan = []; state.pg = null; state.sel = null; state.slots.clear(); renderPlan(); renderList(); renderSched(); renderStep1(); goStep(1); };

  /* ---------- Schritt 2: Auswahl ---------- */
  const usedCats = ['alle', ...Object.keys(CATS).filter((c) => c !== 'alle' && LEISTUNGEN.some((l) => l.cat === c))];
  $('#chips').innerHTML = usedCats.map((c) => `<button class="chip" type="button" data-cat="${c}" aria-pressed="${c === 'alle'}">${ic(CATS[c].icon)}${CATS[c].label}</button>`).join('');
  $$('#chips .chip').forEach((b) => (b.onclick = () => { state.cat = b.dataset.cat; $$('#chips .chip').forEach((x) => x.setAttribute('aria-pressed', String(x === b))); renderList(); }));
  $('#q').oninput = (e: any) => { state.q = e.target.value.trim().toLowerCase(); renderList(); };

  const priceLabel = (l: any) => l.type === 'minute' ? `${eur(l.price)}<small class="per"> / ${__H('plan.minutes')}</small>` : eur(l.price);
  function renderList() {
    const items = LEISTUNGEN.filter((l) => (state.cat === 'alle' || l.cat === state.cat) && (!state.q || l.name.toLowerCase().includes(state.q)));
    $('#svc-list').innerHTML = items.length ? items.map((l) => { const s = splitName(l.name);
      return `<button class="svc" type="button" data-id="${esc(l.id)}" aria-pressed="${state.sel === l.id}">${catIcon(l.cat)}
        <span class="nm">${esc(s.text)}<small>${esc(s.code)}${l.once ? ` · ${__H('plan.once')}` : ''}${l.type === 'minute' ? ` · ${__H('plan.byTime')}` : ''}</small></span>
        <span class="pr-tag">${priceLabel(l)}</span></button>`; }).join('')
      : `<div class="empty-list">${ic('search')} ${__H('plan.noResult')}</div>`;
    $$('.svc').forEach((b) => (b.onclick = () => { state.sel = state.sel === b.dataset.id ? null : b.dataset.id; state.slots.clear(); renderList(); renderSched(); if (state.sel) setTimeout(() => $('#sched').scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'nearest' }), 60); }));
  }
  const svcById = (id: string | null) => LEISTUNGEN.find((l) => l.id === id);

  /* Zeitplan */
  const PRESETS = [
    { t: __H('zeitplan.presetDaily'), f: () => DAYS.map((_, d) => d + '-0') },
    { t: __H('zeitplan.presetWeekdays'), f: () => [0, 1, 2, 3, 4].map((d) => d + '-0') },
    { t: __H('zeitplan.presetMornEve'), f: () => DAYS.flatMap((_, d) => [d + '-0', d + '-3']) },
    { t: __H('zeitplan.presetWeekly'), f: () => ['0-1'] },
  ];
  const unitPrice = (l: any) => unitOf(l, state.dur);
  function renderSched() {
    const box = $('#sched'), l = svcById(state.sel);
    if (!l) { box.classList.add('hidden'); box.innerHTML = ''; return; }
    box.classList.remove('hidden');
    const s = splitName(l.name);
    let h = `<div class="sched-head">${catIcon(l.cat)}<div><b>${esc(s.text)}</b><div class="muted">${esc(s.code)} · ${l.type === 'minute' ? eur(l.price) + ` ${__H('plan.perMinute')}` : eur(l.price) + ` ${__H('plan.perVisit')}`}</div></div></div>`;
    if (l.type === 'minute') {
      h += `<div class="flabel">${ic('clock')}${__H('zeitplan.duration')}</div><div class="durs">${[15, 30, 45, 60, 90].map((m) => `<button class="chip" type="button" data-dur="${m}" aria-pressed="${state.dur === m}">${m} ${__H('plan.minutes')}</button>`).join('')}
        <input type="number" id="dur" min="5" step="5" value="${state.dur}" aria-label="Minuten" inputmode="numeric" /></div>`;
    }
    if (l.once) {
      h += `<div class="rnote">${ic('once')}<div>${__H('zeitplan.onceNote', { fett: `<b>${__H('zeitplan.onceBold')}</b>` })}</div></div>`;
    } else {
      h += `<div class="flabel">${ic('calendar')}${__H('zeitplan.when')}</div>
        <div class="presets">${PRESETS.map((p, i) => `<button class="chip" type="button" data-preset="${i}">${p.t}</button>`).join('')}<button class="chip" type="button" data-preset="clear">${ic('trash')}${__H('zeitplan.clear')}</button></div>
        <div class="sgrid" id="grid"><div></div>${DAYS.map((d, i) => `<div class="h ${i > 4 ? 'we' : ''}">${d}</div>`).join('')}
        ${SLOTS.map((sl, si) => `<div class="rl">${ic(sl.i)}<span>${sl.n}</span></div>` + DAYS.map((_, di) => { const k = di + '-' + si; return `<button class="cell" type="button" data-k="${k}" aria-label="${DAYS[di]} ${sl.n}" aria-pressed="${state.slots.has(k)}">${ic('check')}</button>`; }).join('')).join('')}</div>`;
    }
    h += `<div class="add-row"><span class="sum" id="add-sum" aria-live="polite"></span><button class="btn btn--green" type="button" id="add">${ic('plus')}${__H('zeitplan.add')}</button></div>`;
    box.innerHTML = h;

    box.querySelectorAll('[data-dur]').forEach((b: any) => (b.onclick = () => { state.dur = +b.dataset.dur; renderSched(); }));
    const di = box.querySelector('#dur'); if (di) di.oninput = () => { state.dur = Math.max(5, +di.value || 30); box.querySelectorAll('[data-dur]').forEach((b: any) => b.setAttribute('aria-pressed', String(+b.dataset.dur === state.dur))); updateAddSum(); };
    box.querySelectorAll('[data-preset]').forEach((b: any) => (b.onclick = () => { const p = b.dataset.preset; state.slots = p === 'clear' ? new Set() : new Set(PRESETS[+p].f()); syncCells(); }));
    box.querySelectorAll('.cell').forEach((c: any) => (c.onclick = () => { const k = c.dataset.k; state.slots.has(k) ? state.slots.delete(k) : state.slots.add(k); syncCells(); }));
    box.querySelector('#add').onclick = addToPlan;
    updateAddSum();
  }
  function syncCells() { $$('#grid .cell').forEach((c) => c.setAttribute('aria-pressed', String(state.slots.has(c.dataset.k)))); updateAddSum(); }
  function updateAddSum() {
    const l = svcById(state.sel); if (!l) return;
    const btn = $('#add'), sum = $('#add-sum');
    if (l.once) { sum.innerHTML = __H('zeitplan.sumOnce', { betrag: `<b>${eur(unitPrice(l))}</b>` }); btn.disabled = false; return; }
    const n = state.slots.size;
    btn.disabled = n === 0;
    sum.innerHTML = n ? __H('zeitplan.sumWeekly', { n, betrag: `<b>${eur(unitPrice(l) * n * WPM)}</b>` }) : __H('zeitplan.sumEmpty');
  }
  function addToPlan() {
    const l = svcById(state.sel); if (!l) return;
    const s = splitName(l.name), mins = l.type === 'minute' ? state.dur : null;
    const unit = unitPrice(l);
    if (l.once) {
      state.plan.push({ uid: Date.now() + Math.random(), cat: l.cat, code: s.code, name: s.text, unit, once: true, perWeek: 0, perMonth: 1, when: __T('plan.once') });
    } else {
      const perWeek = state.slots.size;
      const when = SLOTS.map((sl, si) => { const ds = DAYS.map((_, di) => di).filter((di) => state.slots.has(di + '-' + si)); if (!ds.length) return null;
        const k = ds.join(''), lbl = k === '0123456' ? __H('zeitplan.whenDaily') : k === '01234' ? __H('zeitplan.whenWeekdays') : k === '56' ? __H('zeitplan.whenWeekend') : ds.map((d) => DAYS[d]).join(', ');
        return `${sl.n.toLowerCase()} ${lbl}`; }).filter(Boolean).join(' · ');
      state.plan.push({ uid: Date.now() + Math.random(), cat: l.cat, code: s.code, name: s.text + (mins ? ` (${mins} ${__T('plan.minutes')})` : ''), unit, perWeek, perMonth: perWeek * WPM, when });
    }
    toast(__T('zeitplan.added', { name: s.text }));
    state.sel = null; state.slots.clear(); renderList(); renderSched(); renderPlan();
  }

  /* Plan */
  function renderPlan() {
    const el = $('#plan');
    if (!state.plan.length) {
      el.innerHTML = `<div class="plan-empty">${ic('calendar')}<div><b>${__H('planliste.emptyTitle')}</b></div><div class="muted">${__H('planliste.emptyText')}</div></div>`;
    } else {
      el.innerHTML = state.plan.map((p) => `<div class="pitem" data-uid="${p.uid}">${catIcon(p.cat)}
        <div class="info"><b>${esc(p.name)}</b><small>${esc(p.code)} · ${p.once ? __H('plan.once') : __H('planliste.perWeek', { n: p.perWeek, wann: esc(p.when) })}</small></div>
        <div class="amt"><b>${eur(p.once ? p.unit : p.unit * p.perMonth)}</b><small>${p.once ? __H('plan.once') : __H('planliste.perMonth')}</small></div>
        <button class="del" type="button" aria-label="${esc(p.name)} entfernen">${ic('trash')}</button></div>`).join('');
      el.querySelectorAll('.pitem').forEach((row: any) => (row.querySelector('.del').onclick = () => {
        row.classList.add('out');
        setTimeout(() => { state.plan = state.plan.filter((p) => p.uid !== +row.dataset.uid); renderPlan(); }, reduce ? 0 : 240);
      }));
    }
    renderBudgetBar();
  }
  function renderBudgetBar() {
    if (!state.pg) return;
    const cost = monthly(state.plan), budget = state.mode === 'geld' ? 0 : CONFIG.sachleistung[state.pg];
    const pct = budget ? cost / budget : (cost ? 1 : 0);
    const fill = $('#bb-fill');
    fill.style.width = Math.min(100, pct * 100) + '%';
    fill.style.background = state.mode === 'geld' ? 'var(--rc-warn)' : pct > 1 ? 'var(--rc-bad)' : pct > .85 ? 'var(--rc-warn)' : 'var(--green-700)';
    $('#bb-l').innerHTML = `${ic('list')} ${__H('planliste.barPlanned', { betrag: `<b>${eur(cost)}</b>` })}`;
    $('#bb-r').innerHTML = state.mode === 'geld' ? `<span class="muted">${__H('planliste.barPrivate')}</span>`
      : pct > 1 ? `<b class="neg">${__H('planliste.barOver', { betrag: eur(cost - budget) })}</b>`
      : __H('planliste.barFree', { betrag: `<b class="pos">${eur(budget - cost)}</b>`, budget: eur(budget) });
  }

  /* ---------- Schritt 3 ---------- */
  function renderResult() {
    const pg = state.pg!, r = calcPlan(state.mode, pg, state.plan), modeName = MODES.find((m) => m.id === state.mode)!.t;
    $('#res-sub').textContent = __T('ergebnis.sub', { pg, modus: modeName, stand: CONFIG.stand });

    const ring = $('#ring'), C = 314.16;
    const pct = state.mode === 'geld' ? 0 : (r.budget ? Math.min(1, r.cost / r.budget) : 0);
    ring.style.stroke = state.mode !== 'geld' && r.cost > r.budget ? 'var(--rc-bad)' : pct > .85 ? 'var(--rc-warn)' : 'var(--brand-600)';
    ring.style.strokeDashoffset = C;
    requestAnimationFrame(() => requestAnimationFrame(() => (ring.style.strokeDashoffset = C * (1 - pct))));
    const pctEl = $('#ring-pct');
    if (state.mode === 'geld') { pctEl.textContent = '100 %'; $('#ring-lbl').textContent = __T('ergebnis.ringGeld'); ring.style.stroke = 'var(--green-700)'; requestAnimationFrame(() => requestAnimationFrame(() => (ring.style.strokeDashoffset = 0))); }
    else { pctEl._v = 0; countTo(pctEl, Math.round(r.share * 100), (v) => Math.round(v) + ' %'); $('#ring-lbl').textContent = __T('ergebnis.ringUsed'); }

    $('#big-pay').classList.toggle('hidden', state.mode === 'sach');
    $('#pay-l').textContent = state.mode === 'kombi' ? __T('ergebnis.payKombi', { n: Math.round((1 - r.share) * 100) }) : __T('ergebnis.payGeld');
    $('#r-payout')._v = 0; countTo($('#r-payout'), r.payout);
    const big = $('#big-own'); big.className = 'big ' + (r.own > 0 ? 'bad' : 'zero');
    $('#own-ic').innerHTML = ic(r.own > 0 ? 'alert' : 'smile');
    $('#r-own')._v = 0; countTo($('#r-own'), r.own);

    const rows: [string, string][] = [];
    if (state.mode !== 'geld') rows.push([__H('ergebnis.rowBudget'), eur(r.budget)]);
    rows.push([__H('ergebnis.rowCost'), eur(r.cost)]);
    if (state.mode !== 'geld') rows.push([__H('ergebnis.rowUsed'), eur(r.used)]);
    if (state.mode !== 'geld') rows.push([__H('ergebnis.rowRest'), eur(r.rest)]);
    if (r.invest > 0) rows.push([__H('ergebnis.rowInvest'), eur(r.invest)]);
    if (state.plan.some((p) => p.once)) rows.push([__H('ergebnis.rowOnce'), eur(oneoffSum(state.plan))]);
    rows.push([__H('ergebnis.rowEnt'), eur(CONFIG.entlastung)]);
    $('#breakdown').innerHTML = rows.map(([a, b]) => `<tr><td>${a}</td><td>${b}</td></tr>`).join('');

    let t: string;
    if (!state.plan.length) t = __T('ergebnis.explainEmpty');
    else if (state.mode === 'geld') t = __T('ergebnis.explainGeld', { betrag: eur(r.geld), tipp: r.cost ? __T('ergebnis.explainGeldTip') : '' });
    else if (state.mode === 'kombi') t = r.own > 0 ? __T('ergebnis.explainKombiOver', { betrag: eur(r.own) }) : __T('ergebnis.explainKombi', { genutzt: Math.round(r.share * 100), rest: Math.round((1 - r.share) * 100) });
    else t = r.rest > 0 ? __T('ergebnis.explainSachRest', { betrag: eur(r.rest) }) : r.own > 0 ? __T('ergebnis.explainSachOver', { betrag: eur(r.own) }) : __T('ergebnis.explainSachFull');
    $('#r-explain div').textContent = t;
  }

  /* ---------- Entlastungsbetrag ---------- */
  $('#e-rate').textContent = eur(CONFIG.entlastungStundensatz) + ` / ${__T('ent.hoursUnit')}`;
  $('#e-budget').placeholder = CONFIG.entlastung + ' €';
  function renderEnt() {
    const b = $('#e-budget').value === '' ? CONFIG.entlastung : Math.max(0, +$('#e-budget').value);
    const h = +$('#e-hours').value, rate = CONFIG.entlastungStundensatz, cost = h * rate;
    $('#e-hours').max = Math.max(20, Math.ceil(b / rate) + 4);
    $('#e-hours-out').textContent = h.toLocaleString('de-DE') + ` ${__T('ent.hoursUnit')}`;
    countTo($('#e-cost'), cost); countTo($('#e-cov'), Math.min(cost, b)); countTo($('#e-own'), Math.max(0, cost - b));
    $('#e-own-k').className = 'kpi ' + (cost > b ? 'bad' : '');
    const pct = b ? cost / b : 1, bar = $('#e-bar');
    bar.style.width = Math.min(100, pct * 100) + '%'; bar.style.background = pct > 1 ? 'var(--rc-bad)' : pct > .85 ? 'var(--rc-warn)' : 'var(--green-700)';
    const max = Math.floor((b / rate) * 4) / 4;
    $('#e-max div').innerHTML = __H('ent.maxText', { betrag: eur(b), stunden: `<b>${__H('ent.maxHours', { n: max.toLocaleString('de-DE') })}</b>` });
  }
  $('#e-budget').oninput = renderEnt; $('#e-hours').oninput = renderEnt;

  $('#foot').textContent = __T('hinweis.foot', { stand: CONFIG.stand });

  /* ---------- Dialog ab der 3. Berechnung ---------- */
  const gate: HTMLDialogElement = $('#gate');
  const summary = () => {
    const r = calcPlan(state.mode, state.pg!, state.plan), modeName = MODES.find((m) => m.id === state.mode)!.t;
    return [
      `Pflegegrad ${state.pg} · ${modeName} · Stand ${CONFIG.stand}`,
      ...state.plan.map((p) => `- ${p.code} ${p.name}: ${p.once ? 'einmalig ' + eur(p.unit) : `${p.perWeek}× pro Woche (${p.when}) = ${eur(p.unit * p.perMonth)} / Monat`}`),
      `Kosten Pflegeplan: ${eur(r.cost)} / Monat`,
      state.mode === 'geld' ? '' : `Übernimmt die Pflegekasse: ${eur(r.used)} (Budget ${eur(r.budget)})`,
      state.mode === 'sach' ? '' : `Pflegegeld-Auszahlung: ${eur(r.payout)}`,
      `Eigenanteil: ${eur(r.own)} / Monat`,
    ].filter(Boolean).join('\n');
  };
  function openGate() {
    gate.querySelectorAll<HTMLInputElement>('input[name=rechner_ergebnis]').forEach((i) => (i.value = summary()));
    if (typeof gate.showModal === 'function') gate.showModal(); else gate.setAttribute('open', '');
    $('#gate-h').focus();
  }
  const closeGate = () => { if (gate.open) gate.close(); };
  $('#gate-x').onclick = closeGate;
  gate.addEventListener('click', (e) => { if (e.target === gate) closeGate(); }); // Klick auf den Hintergrund
  $$('.opt').forEach((b) => (b.onclick = () => {
    $$('.opt').forEach((x) => { const on = x === b; x.setAttribute('aria-pressed', String(on)); $('#opt-' + x.dataset.opt).hidden = !on; });
  }));
  // Formular im Dialog abgeschickt (Kontaktdaten oder Termin; im Vorschau-Modus ohne Endpoint ebenso) → freischalten und Ergebnis zeigen
  gate.addEventListener('lead-sent', (e) => {
    lsSet(K_OK, '1');
    const msg = ((e.target as HTMLElement).querySelector('.form-status')?.textContent) || __T('gate.thanks');
    closeGate();
    goStep(3);
    toast(msg);
  });

  /* Init */
  renderModes(); renderStep1(); renderList(); renderPlan(); renderEnt();
</script>
<style is:global>
  .rc {
    --rc-warn: #b86e0a; --rc-warn-soft: #fff6e8; --rc-bad: #b42318; --rc-bad-soft: #fef3f2;
    max-width: 900px; margin-inline: auto;
  }
  .rc .hidden { display: none !important; }
  .rc svg.i, .rdlg svg.i, .toast svg.i { inline-size: 1.25em; block-size: 1.25em; flex: none; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; vertical-align: -.25em; }
  .rc h2 { font-size: 1.4rem; letter-spacing: -.015em; margin-block-end: 4px; }
  .rc h3 { font-size: 1.1rem; margin: 22px 0 10px; display: flex; align-items: center; gap: 8px; }
  .rc h3.h3-first { margin-block-start: 0; }
  .rc .card.panel { padding: clamp(18px, 3vw, 28px); margin-block-end: 16px; }
  .rc .panel > .muted { margin-block-end: 14px; font-size: .95rem; }

  /* Tabs */
