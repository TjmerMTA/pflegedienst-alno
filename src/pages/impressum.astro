---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { SITE, getPage } from '../config/site';

// Тексты — в src/content/pages/impressum.json (правятся в админке)
const p = getPage('impressum');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} crumbs={[{ label: p.text('hero.crumb') }]} />
  <section class="section">
    <div class="wrap prose">
      <h2>{p.text('angaben.title')}</h2>
      <Fragment set:html={p.html('angaben.text')} />
      <h2>{p.text('kontakt.title')}</h2>
      <p>{p.text('kontakt.phoneLabel')} <a href={SITE.phoneHref}>{SITE.phone}</a><br />{p.text('kontakt.faxLabel')} {SITE.fax}<br />{p.text('kontakt.emailLabel')} <a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
      <h2>{p.text('aufsicht.title')}</h2>
      <p>{p.text('aufsicht.text')}<br /><span class="muted">{p.text('aufsicht.note')}</span></p>
      <h2>{p.text('beruf.title')}</h2>
      <Fragment set:html={p.html('beruf.text')} />
      <h2>{p.text('versicherung.title')}</h2>
      <p><span class="muted">{p.text('versicherung.note')}</span><br />{p.text('versicherung.text')}</p>
      <h2>{p.text('streit.title')}</h2>
      <Fragment set:html={p.html('streit.text')} />
      <h2>{p.text('inhalte.title')}</h2>
      <Fragment set:html={p.html('inhalte.text')} />
      <h2>{p.text('links.title')}</h2>
      <Fragment set:html={p.html('links.text')} />
      <h2>{p.text('urheber.title')}</h2>
      <Fragment set:html={p.html('urheber.text')} />
    </div>
  </section>
</Base>
