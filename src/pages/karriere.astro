---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import { SITE, whatsappUrl } from '../config/site';
import { getPage } from '../lib/content';

// Тексты и картинки — в src/content/pages/karriere.json (правятся в админке)
// TODO: Beispielstellen — Klient ersetzt sie durch die tatsächlich offenen Stellen (Titel, Text, Eckdaten).
// TODO: Leistungen/Konditionen (Gehalt, Fahrzeug, Urlaub) vom Klienten bestätigen lassen.
const p = getPage('karriere');
const img = p.img('why.image');
const why = p.list<{ icon: string; title: string; text: string }>('benefits.items');
// Eckdaten: одна строка textarea — один пункт (вложенные списки контракт не допускает)
const jobs = p.list<{ title: string; text: string; tags: string }>('jobs.items').map((j) => ({ ...j, tags: j.tags.split('\n').map((t) => t.trim()).filter(Boolean) }));
const offers = p.list<{ text: string }>('offers.items');
const steps = p.list<{ title: string; text: string }>('steps.items');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ label: p.text('hero.crumb') }]}>
    <div class="btn-row hero-cta">
      <a class="btn btn--green" href="#bewerbung">{p.text('hero.buttonApply')}</a>
      <a class="btn btn--white" href="#stellen">{p.text('hero.buttonJobs')}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap split">
      {img && <Image src={img.src} alt={img.alt} widths={[424, 848]} sizes="(max-width: 900px) 100vw, 520px" class="img" />}
      <div>
        <span class="eyebrow">{p.text('why.eyebrow')}</span>
        <h2>{p.text('why.h2')}</h2>
        {p.list<{ text: string }>('why.paragraphs').map((t) => <p>{t.text}</p>)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="head head--center"><span class="eyebrow">{p.text('benefits.eyebrow')}</span><h2>{p.text('benefits.h2')}</h2></div>
      <div class="grid grid-4">
        {why.map((v) => <div class="card"><span class="ico"><Icon name={v.icon} /></span><h3>{v.title}</h3><p>{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section" id="stellen">
    <div class="wrap">
      <div class="head"><span class="eyebrow">{p.text('jobs.eyebrow')}</span><h2>{p.text('jobs.h2')}</h2><p class="lead">{p.text('jobs.lead')}</p></div>
      <div class="grid grid-3">
        {jobs.map((j) => (
          <article class="card job">
            <h3>{j.title}</h3>
            <p>{j.text}</p>
            <ul class="tags">{j.tags.map((t) => <li>{t}</li>)}</ul>
            <a class="btn btn--ghost" href="#bewerbung" data-position={j.title}>{p.text('jobs.button')} <Icon name="arrow" size={18} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{p.text('offers.eyebrow')}</span>
        <h2>{p.text('offers.h2')}</h2>
        <ul class="checks">{offers.map((o) => <li>{o.text}</li>)}</ul>
        <p class="muted">{p.text('offers.noteBefore')} <a href="/ausbildung/">{p.text('offers.noteLink')}</a>{p.text('offers.noteAfter')}</p>
      </div>
      <div>
        <span class="eyebrow">{p.text('steps.eyebrow')}</span>
        <h2>{p.text('steps.h2')}</h2>
        <ol class="steps">
          {steps.map((s, i) => <li><span class="n">{i + 1}</span><div><b>{s.title}</b><p>{s.text}</p></div></li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="section" id="bewerbung">
    <div class="wrap layout">
      <div class="card">
        <h2>{p.text('apply.h2')}</h2>
        <ApplicationForm variant="karriere" id="karriere-form" />
      </div>
      <aside class="side">
        <h3>{p.text('apply.sideTitle')}</h3>
        <p>{p.text('apply.sideText')}</p>
        <a class="c" href={SITE.phoneHref}><span class="ico"><Icon name="phone" /></span><span><small>{p.text('apply.phoneLabel')}</small><b>{SITE.phone}</b></span></a>
        <a class="c" href={`mailto:${SITE.email}`}><span class="ico"><Icon name="mail" /></span><span><small>{p.text('apply.emailLabel')}</small><b>{SITE.email}</b></span></a>
        <a class="c" href={whatsappUrl} target="_blank" rel="noopener"><span class="ico ico--green"><Icon name="whatsapp" /></span><span><small>{p.text('apply.whatsappLabel')}</small><b>{p.text('apply.whatsappText')}</b></span></a>
      </aside>
    </div>
  </section>
</Base>
<script>
  // Klick auf „Dafür bewerben“ wählt die Stelle im Formular vor
  document.querySelectorAll<HTMLElement>('[data-position]').forEach((a) => {
    a.addEventListener('click', () => {
      const sel = document.querySelector<HTMLSelectElement>('#karriere-form select[name=position]');
      if (sel && a.dataset.position) sel.value = a.dataset.position;
    });
  });
</script>
<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .img { inline-size: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .hero-cta { margin-block-start: 24px; display: flex; flex-wrap: wrap; gap: 12px; }
  .job { display: flex; flex-direction: column; gap: 4px; }
  .job .btn { margin-block-start: auto; align-self: flex-start; }
  .job p { flex: 1; }
  .tags { list-style: none; padding: 0; margin: 0 0 18px; display: flex; flex-wrap: wrap; gap: 8px; }
  .tags li { font-size: .82rem; font-weight: 600; padding: 5px 12px; border-radius: 999px; background: var(--brand-50); color: var(--brand-700); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 18px; }
  .steps li { display: flex; gap: 16px; align-items: flex-start; }
  .steps p { margin: 2px 0 0; color: var(--ink-2); }
  .n { flex: none; display: grid; place-items: center; inline-size: 38px; block-size: 38px; border-radius: 50%; background: var(--brand-600); color: #fff; font-weight: 800; }
  .layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: 36px; align-items: start; }
  .layout h2 { font-size: 1.6rem; }
  .side { display: grid; gap: 14px; }
  .side h3, .side p { margin: 0; }
  .c { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border: 1px solid var(--line); border-radius: 18px; background: #fff; text-decoration: none; color: var(--ink); }
  a.c:hover { border-color: var(--brand); color: var(--ink); }
  .c > span:last-child { display: grid; gap: 2px; min-inline-size: 0; overflow-wrap: anywhere; }
  .c small { color: var(--muted); }
  .c .ico { margin: 0; }
  @media (max-width: 900px) { .split, .layout { grid-template-columns: 1fr; } }
</style>
