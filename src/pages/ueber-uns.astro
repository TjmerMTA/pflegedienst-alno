---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Certificates from '../components/Certificates.astro';
import CtaBand from '../components/CtaBand.astro';
import { getPage } from '../lib/content';
import '../config/site'; // держит число импортов прежним: иначе меняется порядок <style> (docs/admin-content-format.md, § 5)

// Команда: карточки лежат в src/content/team/*.md и правятся клиентом в Pages CMS.
const team = (await getCollection('team', ({ data }) => !data.hidden)).sort((a, b) => a.data.order - b.data.order);
const initials = (m: { name: string; role: string }) =>
  m.name === 'N. N.' ? m.role[0] : m.name.split(' ').map((w) => w[0]).join('');
// Тексты и картинки — в src/content/pages/ueber-uns.json (правятся в админке)
const p = getPage('ueber-uns');
const teamImg = p.img('leitbild.image');
const careImg = p.img('quals.image');
const quals = p.list<{ text: string }>('quals.items');
const values = p.list<{ icon: string; title: string; text: string }>('values.items');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ label: p.text('hero.crumb') }]} />

  <section class="section">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{p.text('leitbild.eyebrow')}</span>
        <h2>{p.text('leitbild.h2')}</h2>
        {p.list<{ text: string }>('leitbild.paragraphs').map((t) => <p>{t.text}</p>)}
      </div>
      {teamImg && <Image src={teamImg.src} alt={teamImg.alt} widths={[424]} class="img" />}
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="head head--center"><span class="eyebrow">{p.text('values.eyebrow')}</span><h2>{p.text('values.h2')}</h2></div>
      <div class="grid grid-4">
        {values.map((v) => <div class="card"><span class="ico"><Icon name={v.icon} /></span><h3>{v.title}</h3><p>{v.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section" id="team">
    <div class="wrap">
      <div class="head"><span class="eyebrow">{p.text('team.eyebrow')}</span><h2>{p.text('team.h2')}</h2><p class="lead">{p.text('team.lead')}</p></div>
      <div class="grid grid-4">
        {team.map(({ data: m }) => (
          <figure class="card member">
            {m.photo
              ? <Image src={m.photo} alt={`${m.name}, ${m.role}`} width={120} height={120} densities={[1, 2]} class="ph ph--img" />
              : <div class="ph" aria-hidden="true">{initials(m)}</div>}
            <figcaption><b>{m.name}</b><span class="role">{m.role}</span>{m.description && <small>{m.description}</small>}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      {careImg && <Image src={careImg.src} alt={careImg.alt} widths={[424]} class="img" />}
      <div>
        <span class="eyebrow">{p.text('quals.eyebrow')}</span>
        <h2>{p.text('quals.h2')}</h2>
        <p>{p.text('quals.text')}</p>
        <ul class="checks">{quals.map((q) => <li>{q.text}</li>)}</ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head head--center"><span class="eyebrow">{p.text('certs.eyebrow')}</span><h2>{p.text('certs.h2')}</h2></div>
      <Certificates />
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap jobs card">
      <div><h2>{p.text('jobs.h2')}</h2><p>{p.text('jobs.text')}</p></div>
      <div class="btn-row">
        <a class="btn btn--primary" href="/karriere/">{p.text('jobs.buttonJobs')}</a>
        <a class="btn btn--ghost" href="/ausbildung/">{p.text('jobs.buttonTraining')}</a>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .img { inline-size: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .member { margin: 0; text-align: center; }
  .ph { inline-size: 120px; block-size: 120px; margin: 0 auto 18px; border-radius: 50%; display: grid; place-items: center; font-size: 2.2rem; font-weight: 800; color: #fff; background: linear-gradient(135deg, var(--brand), var(--brand-700)); box-shadow: 0 0 0 6px var(--green-50), 0 0 0 9px var(--green); }
  .ph--img { display: block; object-fit: cover; background: var(--green-50); }
  figcaption { display: grid; gap: 4px; }
  .role { color: var(--brand-700); font-weight: 700; }
  small { color: var(--muted); }
  .jobs { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; }
  .jobs p { margin: 0; max-width: 640px; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
</style>
