---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ApplicationForm from '../components/ApplicationForm.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, getPage } from '../config/site';

// Тексты — в src/content/pages/ausbildung.json (правятся в админке)
const p = getPage('ausbildung');
const ways = p.list<{ icon: string; title: string; text: string; tag: string }>('ways.items');
const gets = p.list<{ icon: string; title: string; text: string }>('gets.items');
const reqs = p.list<{ text: string }>('reqs.items');
const stages = p.list<{ title: string; text: string }>('training.stages');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ label: p.text('hero.crumb') }]}>
    <div class="btn-row hero-cta">
      <a class="btn btn--green" href="#bewerbung">{p.text('hero.buttonApply')}</a>
      <a class="btn btn--white" href="#wege">{p.text('hero.buttonWays')}</a>
    </div>
  </PageHero>

  <section class="section" id="wege">
    <div class="wrap">
      <div class="head"><span class="eyebrow">{p.text('ways.eyebrow')}</span><h2>{p.text('ways.h2')}</h2><p class="lead">{p.text('ways.lead')}</p></div>
      <div class="grid grid-4">
        {ways.map((w) => (
          <article class="card way">
            <span class="ico"><Icon name={w.icon} /></span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
            <a class="more" href="#bewerbung" data-wunsch={w.tag}>{p.text('ways.button')} <Icon name="arrow" size={16} /></a>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{p.text('training.eyebrow')}</span>
        <h2>{p.text('training.h2')}</h2>
        <p>{p.text('training.textBefore')} <b>{p.text('training.textBold')}</b> {p.text('training.textAfter')}</p>
        <p>{p.text('training.text2')}</p>
        {/* TODO: Partnerschule (Name, Ort, Link) vom Klienten bestätigen lassen; Ausbildungsstart (Termine) und Zahl der Plätze ergänzen. */}
        <p class="muted">{p.text('training.note')}</p>
      </div>
      <ol class="stages">
        {stages.map((s) => <li><b>{s.title}</b><p>{s.text}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head head--center"><span class="eyebrow">{p.text('gets.eyebrow')}</span><h2>{p.text('gets.h2')}</h2></div>
      <div class="grid grid-4">
        {gets.map((g) => <div class="card"><span class="ico ico--green"><Icon name={g.icon} /></span><h3>{g.title}</h3><p>{g.text}</p></div>)}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      <div>
        <span class="eyebrow">{p.text('reqs.eyebrow')}</span>
        <h2>{p.text('reqs.h2')}</h2>
        <ul class="checks">{reqs.map((r) => <li>{r.text}</li>)}</ul>
        <p class="muted">{p.text('reqs.note')}</p>
      </div>
      <div class="card ask">
        <h3>{p.text('ask.title')}</h3>
        <p>{p.text('ask.text')}</p>
        <a class="btn btn--primary" href={SITE.phoneHref}><Icon name="phone" size={20} /> {SITE.phone}</a>
        <a class="btn btn--ghost" href="/karriere/">{p.text('ask.button')}</a>
      </div>
    </div>
  </section>

  <section class="section" id="bewerbung">
    <div class="wrap form-wrap">
      <div class="card">
        <h2>{p.text('apply.h2')}</h2>
        <ApplicationForm variant="ausbildung" id="ausbildung-form" />
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<script>
  // Klick auf „Dafür bewerben“ wählt den Wunsch im Formular vor
  document.querySelectorAll<HTMLElement>('[data-wunsch]').forEach((a) => {
    a.addEventListener('click', () => {
      const r = [...document.querySelectorAll<HTMLInputElement>('#ausbildung-form input[name=wunsch]')].find((i) => i.value === a.dataset.wunsch);
      if (r) r.checked = true;
    });
  });
</script>
<style>
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .hero-cta { margin-block-start: 24px; }
  .way { display: flex; flex-direction: column; }
  .way p { flex: 1; }
  .more { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; color: var(--brand-700); text-decoration: none; }
  .more:hover { text-decoration: underline; }
  .stages { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; counter-reset: s; }
  .stages li { position: relative; padding: 18px 22px 18px 72px; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow); counter-increment: s; }
  .stages li::before { content: counter(s); position: absolute; inset-inline-start: 20px; inset-block-start: 18px; display: grid; place-items: center; inline-size: 38px; block-size: 38px; border-radius: 50%; background: var(--brand-600); color: #fff; font-weight: 800; }
  .stages p { margin: 2px 0 0; color: var(--ink-2); }
  .ask { display: grid; gap: 14px; justify-items: start; }
  .ask h3, .ask p { margin: 0; }
  .form-wrap { max-width: 820px; }
  .form-wrap h2 { font-size: 1.6rem; }
  @media (max-width: 900px) { .split { grid-template-columns: 1fr; } }
  @media (max-width: 640px) { .ask .btn { inline-size: 100%; white-space: normal; } .stages li { padding-inline-start: 66px; } }
</style>
