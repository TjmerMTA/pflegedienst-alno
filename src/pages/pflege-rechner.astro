---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Rechner from '../components/Rechner.astro';
import CtaBand from '../components/CtaBand.astro';

// Тексты — в src/content/pages/pflege-rechner.json (правятся в админке)
// Импорт динамический: новый статический сдвинул бы порядок <style> на страницах (см. Certificates.astro)
const { getPage } = await import('../lib/content');
const p = getPage('pflege-rechner');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ href: '/kosten-finanzierung/', label: p.text('hero.crumbParent') }, { label: p.text('hero.crumb') }]} />
  <section class="section">
    <div class="wrap">
      <Rechner />
    </div>
  </section>
  <CtaBand />
</Base>
