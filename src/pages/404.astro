---
import Base from '../layouts/Base.astro';
import { SITE, getPage } from '../config/site';
// Тексты — в src/content/pages/404.json (правятся в админке)
const p = getPage('404');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')} noindex>
  <section class="section">
    <div class="wrap nf">
      <p class="code">404</p>
      <h1>{p.text('content.h1')}</h1>
      <p class="lead">{p.text('content.leadBefore')} <a href={SITE.phoneHref}>{SITE.phone}</a></p>
      <div class="btn-row"><a class="btn btn--primary" href="/">{p.text('content.buttonHome')}</a><a class="btn btn--ghost" href="/leistungen/">{p.text('content.buttonServices')}</a><a class="btn btn--ghost" href="/kontakt/">{p.text('content.buttonContact')}</a></div>
    </div>
  </section>
</Base>
<style>
  .nf { text-align: center; max-width: 720px; }
  .nf .btn-row { justify-content: center; }
  .code { font-size: 6rem; font-weight: 800; color: var(--brand-100); line-height: 1; margin: 0; }
</style>
