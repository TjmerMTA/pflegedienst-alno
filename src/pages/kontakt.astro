---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import ServiceArea from '../components/ServiceArea.astro';
import { SITE, whatsappUrl, getPage } from '../config/site';
// Тексты — в src/content/pages/kontakt.json (правятся в админке)
const p = getPage('kontakt');
const { lat, lng } = SITE.geo;
const osm = `https://www.openstreetmap.org/export/embed.html?bbox=${lng - 0.012}%2C${lat - 0.006}%2C${lng + 0.012}%2C${lat + 0.006}&layer=mapnik&marker=${lat}%2C${lng}`;
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ label: p.text('hero.crumb') }]} />
  <section class="section">
    <div class="wrap layout">
      <div class="card">
        <h2>{p.text('form.h2')}</h2>
        <ContactForm variant="beratung" id="kontakt-form" />
      </div>
      <aside class="side">
        <a class="c" href={SITE.phoneHref}><span class="ico"><Icon name="phone" /></span><span><small>{p.text('side.phoneLabel')}</small><b>{SITE.phone}</b><small>{p.text('side.phoneAlt')}</small></span></a>
        <a class="c" href={whatsappUrl} target="_blank" rel="noopener"><span class="ico ico--green"><Icon name="whatsapp" /></span><span><small>{p.text('side.whatsappLabel')}</small><b>{p.text('side.whatsappText')}</b></span></a>
        <a class="c" href={`mailto:${SITE.email}`}><span class="ico"><Icon name="mail" /></span><span><small>{p.text('side.emailLabel')}</small><b>{SITE.email}</b></span></a>
        <div class="c"><span class="ico ico--green"><Icon name="pin" /></span><span><small>{p.text('side.addressLabel')}</small><b>{SITE.street}</b><span>{p.text('side.addressCity')}</span><small>{p.text('side.addressFax')}</small></span></div>
        <div class="c"><span class="ico"><Icon name="clock" /></span><span><small>{p.text('side.hoursLabel')}</small>{SITE.hours.map((h) => <span><b>{h.days}:</b> {h.time}</span>)}</span></div>
      </aside>
    </div>
  </section>
  <section class="section section--soft" id="anfahrt">
    <div class="wrap split">
      <div>
        <h2>{p.text('anfahrt.h2')}</h2>
        <div class="map" data-map={osm}>
          <div class="map-ph">
            <Icon name="pin" size={36} />
            <p>{p.text('anfahrt.mapNotice')}</p>
            <button class="btn btn--primary" type="button">{p.text('anfahrt.mapButton')}</button>
            <a href={`https://www.openstreetmap.org/?mlat=${lat}&mlon=${lng}#map=16/${lat}/${lng}`} target="_blank" rel="noopener">{p.text('anfahrt.mapLink')}</a>
          </div>
        </div>
      </div>
      <div>
        <h2>{p.text('area.h2')}</h2>
        <ServiceArea />
      </div>
    </div>
  </section>
</Base>
<script>
  // Подпись карты — из kontakt.json, подставляется при сборке (src/lib/client-texts.mjs)
  declare const __KONTAKT_MAP_TITLE__: string;
  document.querySelectorAll<HTMLElement>('[data-map]').forEach((m) => {
    m.querySelector('button')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = m.dataset.map!;
      frame.title = __KONTAKT_MAP_TITLE__;
      frame.loading = 'lazy';
      m.replaceChildren(frame);
    });
  });
</script>
<style>
  .layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: 36px; align-items: start; }
  .layout h2 { font-size: 1.6rem; }
  .side { display: grid; gap: 14px; }
  .c { display: flex; gap: 16px; align-items: flex-start; padding: 18px 20px; border: 1px solid var(--line); border-radius: 18px; background: #fff; text-decoration: none; color: var(--ink); }
  a.c:hover { border-color: var(--brand); color: var(--ink); }
  .c .ico { margin: 0; }
  .c > span:last-child { display: grid; gap: 2px; }
  .c small { color: var(--muted); }
  .c b { font-size: 1.1rem; word-break: break-word; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: start; }
  .map { border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #fff; aspect-ratio: 4/3; }
  .map :global(iframe) { inline-size: 100%; block-size: 100%; border: 0; }
  .map-ph { block-size: 100%; display: grid; place-content: center; justify-items: center; gap: 12px; text-align: center; padding: 24px; color: var(--ink-2); background: repeating-linear-gradient(45deg, var(--bg-soft) 0 12px, #fff 12px 24px); }
  .map-ph :global(svg) { color: var(--brand-600); }
  .map-ph p { max-width: 380px; font-size: .92rem; margin: 0; }
  @media (max-width: 900px) { .layout, .split { grid-template-columns: 1fr; } }
</style>
