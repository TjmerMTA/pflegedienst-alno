---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceArea from '../components/ServiceArea.astro';
import Certificates from '../components/Certificates.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, whatsappUrl } from '../config/site';
import { FAQ, faqSchema } from '../config/faq';
import { getPage } from '../lib/content';

// Тексты и картинки — в src/content/pages/index.json (правятся в админке)
const p = getPage('index');
const heroImg = p.img('hero.image')!;
const homeImg = p.img('why.image')!;
const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
<Base title={p.text('seo.title')} description={p.text('seo.description')} schema={[faqSchema()]}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <span class="pill"><Icon name="pin" size={16} /> {p.text('hero.pill')}</span>
        <h1>{p.text('hero.h1')} <span class="hl">{p.text('hero.h1Highlight')}</span></h1>
        <p class="lead">{p.text('hero.lead')}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/erstbegutachtung/"><Icon name="calendar" size={20} /> {p.text('hero.button')}</a>
          <a class="btn btn--ghost" href={SITE.phoneHref}><Icon name="phone" size={20} /> {SITE.phone}</a>
        </div>
        <p class="tel-hint"><Icon name="phone" size={18} /> <span>{p.text('hero.telHintBefore')} <a href={SITE.phoneHref}>{SITE.phone}</a> {p.text('hero.telHintAfter')}</span></p>
        <ul class="trust">
          {p.list<{ icon: string; text: string }>('hero.trust').map((t) => <li><Icon name={t.icon} size={20} /> {t.text}</li>)}
        </ul>
      </div>
      <div class="hero-vis">
        <div class="ring"></div>
        <Image src={heroImg.src} alt={heroImg.alt} widths={[480, 960]} sizes="(max-width: 900px) 80vw, 480px" loading="eager" fetchpriority="high" class="hero-img" />
        <div class="float f1"><span class="ico ico--green"><Icon name="check" /></span><span><b>{p.text('hero.badgeTitle')}</b><small>{p.text('hero.badgeText')}</small></span></div>
        <div class="float f2"><b>{p.text('hero.hoursTitle')}</b><small>{p.text('hero.hoursText')}</small></div>
      </div>
    </div>
  </section>

  <section class="quick">
    <div class="wrap quick-in">
      <a href={SITE.phoneHref} class="q"><span class="ico"><Icon name="phone" /></span><span><b>{p.text('quick.callTitle')}</b><small>{SITE.phone}</small></span></a>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="q"><span class="ico ico--green"><Icon name="whatsapp" /></span><span><b>{p.text('quick.whatsappTitle')}</b><small>{p.text('quick.whatsappText')}</small></span></a>
      <a href="#rueckruf" class="q"><span class="ico"><Icon name="chat" /></span><span><b>{p.text('quick.callbackTitle')}</b><small>{p.text('quick.callbackText')}</small></span></a>
      <a href="/erstbegutachtung/" class="q"><span class="ico ico--green"><Icon name="calendar" /></span><span><b>{p.text('quick.visitTitle')}</b><small>{p.text('quick.visitText')}</small></span></a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.text('services.eyebrow')}</span>
        <h2>{p.text('services.h2')}</h2>
        <p class="lead">{p.text('services.lead')}</p>
      </div>
      <div class="grid grid-3">
        {leistungen.map((l) => (
          <a class="card svc" href={`/leistungen/${l.id}/`}>
            <span class="ico"><Icon name={l.data.icon} /></span>
            <h3>{l.data.title}</h3>
            <p>{l.data.teaser}</p>
            <span class="more">{p.text('services.more')} <Icon name="arrow" size={18} /></span>
          </a>
        ))}
        <a class="card svc svc--cta" href="/kosten-finanzierung/">
          <span class="ico ico--green"><Icon name="euro" /></span>
          <h3>{p.text('services.costTitle')}</h3>
          <p>{p.text('services.costText')}</p>
          <span class="more"><Fragment set:html={p.textHtml('services.costMore')} /> <Icon name="arrow" size={18} /></span>
        </a>
      </div>
      <a class="calc-tease" href="/pflege-rechner/">
        <span class="ico ico--green"><Icon name="euro" /></span>
        <span><b>{p.text('services.calcTitle')}</b><small>{p.text('services.calcText')}</small></span>
        <span class="more">{p.text('services.calcMore')} <Icon name="arrow" size={18} /></span>
      </a>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      <div class="media">
        <Image src={homeImg.src} alt={homeImg.alt} widths={[424]} />
        <div class="stat"><b>{p.text('why.statValue')}</b><span>{p.text('why.statText')}</span></div>
      </div>
      <div>
        <span class="eyebrow">{p.text('why.eyebrow')}</span>
        <h2>{p.text('why.h2')}</h2>
        <p class="lead">{p.text('why.lead')}</p>
        <ul class="why">
          {p.list<{ icon: string; title: string; text: string }>('why.items').map((w) => (
            <li><span class="ico"><Icon name={w.icon} /></span><div><h3>{w.title}</h3><p>{w.text}</p></div></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow" set:html={p.textHtml('steps.eyebrow')} />
        <h2>{p.text('steps.h2')}</h2>
      </div>
      <ol class="steps">
        {p.list<{ title: string; text: string }>('steps.items').map((st, i) => (
          <li><span class="n">{i + 1}</span><h3>{st.title}</h3><p>{st.text}</p></li>
        ))}
      </ol>
      <div class="center"><a class="btn btn--primary" href="/erstbegutachtung/">{p.text('steps.button')} <Icon name="arrow" size={20} /></a></div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">{p.text('testimonials.eyebrow')}</span>
        <h2>{p.text('testimonials.h2')}</h2>
      </div>
      <Testimonials />
      <div class="certs-wrap">
        <h2 class="h3" set:html={p.textHtml('testimonials.certsTitle')} />
        <Certificates />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.text('area.eyebrow')}</span>
        <h2>{p.text('area.h2')}</h2>
        <p class="lead">{p.text('area.lead')}</p>
      </div>
      <ServiceArea />
    </div>
  </section>

  <section class="section section--soft" id="rueckruf">
    <div class="wrap split split--form">
      <div>
        <span class="eyebrow">{p.text('callback.eyebrow')}</span>
        <h2>{p.text('callback.h2')}</h2>
        <p class="lead">{p.text('callback.lead')}</p>
        <p class="visit"><Icon name="pin" size={20} /> <span>{p.text('callback.visitBefore')} <a href={SITE.phoneHref}>{SITE.phone}</a> {p.text('callback.visitAfter')}</span></p>
        <ul class="checks">
          {p.list<{ text: string }>('callback.checks').map((c) => <li>{c.text}</li>)}
        </ul>
      </div>
      <div class="card"><ContactForm variant="rueckruf" id="rueckruf-form" /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--faq">
      <div class="head">
        <span class="eyebrow">{p.text('faq.eyebrow')}</span>
        <h2>{p.text('faq.h2')}</h2>
        <p class="lead">{p.text('faq.lead')}</p>
        <a class="btn btn--ghost" href={SITE.phoneHref}><Icon name="phone" size={20} /> {SITE.phone}</a>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <div class="head row-head">
          <div><span class="eyebrow">{p.text('blog.eyebrow')}</span><h2>{p.text('blog.h2')}</h2></div>
          <a class="btn btn--ghost" href="/blog/">{p.text('blog.allButton')} <Icon name="arrow" size={18} /></a>
        </div>
        <div class="grid grid-3">
          {posts.map((post) => (
            <a class="card post" href={`/blog/${post.id}/`}>
              <time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</time>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="more">{p.text('blog.more')} <Icon name="arrow" size={18} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
<style>
  .hero { background: radial-gradient(900px 500px at 85% 0%, var(--brand-50), transparent 65%), radial-gradient(600px 400px at 0% 100%, var(--green-50), transparent 60%); padding-block: clamp(36px, 6vw, 80px) clamp(40px, 6vw, 72px); overflow: hidden; }
  @media (min-width: 1021px) { .hero { padding-block: clamp(29px, 4.8vw, 64px) clamp(32px, 4.8vw, 58px); } }
  .hero-in { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(30px, 5vw, 64px); align-items: center; }
  .hero h1 { margin-block: 18px 20px; }
  .hl { color: var(--brand-600); }
  .hero .lead { max-width: 560px; margin-block-end: 28px; }
  .tel-hint { display: flex; gap: 8px; align-items: flex-start; margin: 18px 0 0; font-weight: 600; color: var(--ink-2); }
  .tel-hint :global(svg), .visit :global(svg) { flex: none; margin-block-start: 3px; color: var(--green-700); }
  .tel-hint a, .visit a { color: var(--brand-700); white-space: nowrap; }
  .visit { display: flex; gap: 10px; align-items: flex-start; padding: 14px 16px; border-radius: 14px; background: #fff; border: 1px solid var(--line); }
  .trust { display: flex; flex-wrap: wrap; gap: 10px 22px; list-style: none; padding: 0; margin: 28px 0 0; color: var(--ink-2); font-weight: 600; }
  .trust li { display: flex; gap: 8px; align-items: center; }
  .trust :global(svg) { color: var(--green-700); }
  .hero-vis { position: relative; justify-self: center; inline-size: min(100%, 460px); }
  .ring { position: absolute; inset: -6%; border-radius: 50%; border: 14px solid var(--green); opacity: .9; }
  .ring::before { content: ''; position: absolute; inset: 14px; border-radius: 50%; background: var(--brand); }
  .hero-img { position: relative; inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 10px solid #fff; box-shadow: var(--shadow-lg); }
  .float { position: absolute; display: flex; gap: 12px; align-items: center; background: #fff; border-radius: 16px; padding: 12px 16px; box-shadow: var(--shadow-lg); line-height: 1.25; }
  .float small { display: block; color: var(--muted); font-size: .82rem; }
  .float .ico { margin: 0; inline-size: 40px; block-size: 40px; border-radius: 12px; }
  .f1 { inset-block-end: 4%; inset-inline-start: -8%; }
  .f2 { inset-block-start: 6%; inset-inline-end: -4%; display: grid; text-align: center; gap: 0; }
  .f2 b { font-size: 1.3rem; color: var(--brand-700); }
  .quick { margin-block-start: -8px; }
  .quick-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .q { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 16px 18px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow); transition: transform .15s, border-color .15s; }
  .q:hover { transform: translateY(-2px); border-color: var(--brand); color: var(--ink); }
  .q .ico { margin: 0; inline-size: 48px; block-size: 48px; }
  .q span:last-child { display: grid; line-height: 1.3; }
  .q small { color: var(--muted); }
  .svc { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); transition: transform .15s, border-color .15s, box-shadow .15s; }
  .svc:hover { transform: translateY(-3px); border-color: var(--brand-100); box-shadow: var(--shadow-lg); color: var(--ink); }
  .svc p { color: var(--ink-2); flex: 1; }
  .svc--cta { background: linear-gradient(160deg, var(--green-50), #fff 60%); }
  /* 6 услуг + карточка «Wer bezahlt» — карточка во всю ширину, чтобы не висела одна в последнем ряду */
  .svc--cta { grid-column: 1 / -1; }
  @media (min-width: 900px) { .svc--cta { display: grid; grid-template-columns: auto auto 1fr auto; column-gap: 24px; align-items: center; } .svc--cta h3, .svc--cta p, .svc--cta .ico { margin: 0; } }
  .calc-tease { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; margin-block-start: 22px; padding: 14px 20px; border-radius: var(--radius); border: 1px dashed var(--brand); background: var(--brand-50); text-decoration: none; color: var(--ink); transition: background .15s, transform .15s; }
  .calc-tease:hover { background: #fff; transform: translateY(-1px); color: var(--ink); }
  .calc-tease .ico { margin: 0; inline-size: 44px; block-size: 44px; border-radius: 14px; }
  .calc-tease > span:nth-child(2) { display: grid; line-height: 1.35; flex: 1; min-inline-size: 200px; }
  .calc-tease small { color: var(--ink-2); font-size: .92rem; }
  .calc-tease .more { margin: 0; }
  .more { display: inline-flex; gap: 6px; align-items: center; font-weight: 700; color: var(--brand-600); margin-block-start: 8px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .split--form, .split--faq { align-items: start; }
  .split--faq { grid-template-columns: .8fr 1.2fr; }
  .media { position: relative; }
  .media img { inline-size: 100%; aspect-ratio: 4/3.4; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .stat { position: absolute; inset-block-end: -22px; inset-inline-end: 22px; background: var(--brand-600); color: #fff; border-radius: 18px; padding: 16px 20px; display: grid; box-shadow: var(--shadow-lg); }
  .stat b { font-size: 1.8rem; line-height: 1; }
  .why { list-style: none; padding: 0; margin: 26px 0 0; display: grid; gap: 22px; }
  .why li { display: flex; gap: 16px; }
  .why .ico { margin: 0; }
  .why h3 { font-size: 1.1rem; margin-block-end: 4px; }
  .why p { margin: 0; color: var(--ink-2); }
  .steps { list-style: none; padding: 0; margin: 0 0 36px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; counter-reset: s; }
  .steps li { position: relative; padding: 30px 26px; border-radius: var(--radius); background: var(--bg-soft); }
  .steps li:not(:last-child)::after { content: ''; position: absolute; inset-block-start: 52px; inset-inline-end: -18px; inline-size: 14px; block-size: 14px; border-block-start: 3px solid var(--brand-100); border-inline-end: 3px solid var(--brand-100); rotate: 45deg; }
  .n { display: grid; place-items: center; inline-size: 44px; block-size: 44px; border-radius: 50%; background: var(--brand-600); color: #fff; font-weight: 800; font-size: 1.2rem; margin-block-end: 16px; }
  .steps p { margin: 0; color: var(--ink-2); }
  .center { text-align: center; }
  .certs-wrap { margin-block-start: 56px; }
  .h3 { font-size: 1.3rem; text-align: center; margin-block-end: 22px; }
  .row-head { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .row-head h2 { margin: 0; }
  .post { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; }
  .post:hover { border-color: var(--brand-100); color: var(--ink); }
  .post p { color: var(--ink-2); flex: 1; }
  time { font-size: .86rem; color: var(--muted); margin-block-end: 8px; }
  @media (max-width: 980px) {
    .hero-in, .split, .split--faq { grid-template-columns: 1fr; }
    .hero-vis { inline-size: min(78%, 400px); margin-block-start: 20px; }
    .quick-in { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr; }
    .steps li::after { display: none; }
  }
  @media (max-width: 520px) {
    .quick-in { grid-template-columns: 1fr; }
    .f1 { inset-inline-start: -4%; }
    .q { padding: 12px 14px; }
  }
</style>
