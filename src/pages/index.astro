---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import Faq from '../components/Faq.astro';
import Testimonials from '../components/Testimonials.astro';
import ServiceArea from '../components/ServiceArea.astro';
import Certificates from '../components/Certificates.astro';
import CtaBand from '../components/CtaBand.astro';
import { SITE, whatsappUrl } from '../config/site';
import { FAQ, faqSchema } from '../config/faq';
import heroImg from '../assets/img/familie.jpg';
import homeImg from '../assets/img/pflege-zuhause.jpg';

const leistungen = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort((a, b) => +b.data.date - +a.data.date).slice(0, 3);
---
<Base title="Ambulanter Pflegedienst in Dortmund | Pflegedienst ALNO GmbH" description="Pflegedienst ALNO in Dortmund-Hörde: Grundpflege, Behandlungspflege, Verhinderungspflege und Betreuung zu Hause. Abrechnung mit allen Kassen. Jetzt kostenlos beraten lassen." schema={[faqSchema()]}>
  <section class="hero">
    <div class="wrap hero-in">
      <div class="hero-txt">
        <span class="pill"><Icon name="pin" size={16} /> Ambulante Pflege in Dortmund</span>
        <h1>Gut versorgt zu Hause – <span class="hl">mit Herz und Fachwissen</span></h1>
        <p class="lead">Wir pflegen Ihre Angehörigen dort, wo sie sich am wohlsten fühlen: im eigenen Zuhause. Examinierte Pflegekräfte, feste Bezugspersonen und Abrechnung direkt mit der Pflege- und Krankenkasse.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/erstbegutachtung/"><Icon name="calendar" size={20} /> Kostenlose Erstbegutachtung</a>
          <a class="btn btn--ghost" href={SITE.phoneHref}><Icon name="phone" size={20} /> {SITE.phone}</a>
        </div>
        <ul class="trust">
          <li><Icon name="shield" size={20} /> Alle Kassen</li>
          <li><Icon name="clock" size={20} /> 24/7 Rufbereitschaft</li>
          <li><Icon name="heart" size={20} /> Feste Bezugspflege</li>
        </ul>
      </div>
      <div class="hero-vis">
        <div class="ring"></div>
        <Image src={heroImg} alt="Pflegekraft des Pflegedienstes ALNO mit einer Seniorin zu Hause" widths={[424]} loading="eager" fetchpriority="high" class="hero-img" />
        <div class="float f1"><span class="ico ico--green"><Icon name="check" /></span><span><b>Beratung kostenlos</b><small>auch im Krankenhaus</small></span></div>
        <div class="float f2"><b>24/7</b><small>Rufbereitschaft</small></div>
      </div>
    </div>
  </section>

  <section class="quick">
    <div class="wrap quick-in">
      <a href={SITE.phoneHref} class="q"><span class="ico"><Icon name="phone" /></span><span><b>Anrufen</b><small>{SITE.phone}</small></span></a>
      <a href={whatsappUrl} target="_blank" rel="noopener" class="q"><span class="ico ico--green"><Icon name="whatsapp" /></span><span><b>WhatsApp</b><small>Schreiben Sie uns</small></span></a>
      <a href="#rueckruf" class="q"><span class="ico"><Icon name="chat" /></span><span><b>Rückruf</b><small>Wir melden uns bei Ihnen</small></span></a>
      <a href="/erstbegutachtung/" class="q"><span class="ico ico--green"><Icon name="calendar" /></span><span><b>Erstbegutachtung</b><small>Termin zu Hause</small></span></a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Unsere Leistungen</span>
        <h2>Pflege, die sich nach Ihrem Alltag richtet</h2>
        <p class="lead">Von der Unterstützung am Morgen bis zur ärztlich verordneten Wundversorgung – wir stellen die Versorgung genau so zusammen, wie sie gebraucht wird.</p>
      </div>
      <div class="grid grid-3">
        {leistungen.map((l) => (
          <a class="card svc" href={`/leistungen/${l.id}/`}>
            <span class="ico"><Icon name={l.data.icon} /></span>
            <h3>{l.data.title}</h3>
            <p>{l.data.teaser}</p>
            <span class="more">Mehr erfahren <Icon name="arrow" size={18} /></span>
          </a>
        ))}
        <a class="card svc svc--cta" href="/kosten-finanzierung/">
          <span class="ico ico--green"><Icon name="euro" /></span>
          <h3>Wer bezahlt die Pflege?</h3>
          <p>Pflegegeld, Sachleistung, Entlastungsbetrag: So nutzen Sie die Leistungen der Pflegekasse voll aus.</p>
          <span class="more">Kosten & Finanzierung <Icon name="arrow" size={18} /></span>
        </a>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap split">
      <div class="media">
        <Image src={homeImg} alt="Pflegerin und Seniorin lächeln gemeinsam im Wohnzimmer" widths={[424]} />
        <div class="stat"><b>100 %</b><span>Pflege im gewohnten Zuhause</span></div>
      </div>
      <div>
        <span class="eyebrow">Warum ALNO</span>
        <h2>Vertrauen entsteht durch Menschen, die bleiben</h2>
        <p class="lead">Wir sind ein inhabergeführter Pflegedienst aus Dortmund-Hörde. Bei uns kennt man sich – Patienten, Angehörige und Pflegekräfte.</p>
        <ul class="why">
          <li><span class="ico"><Icon name="users" /></span><div><h3>Feste Bezugspflegekräfte</h3><p>Möglichst immer dieselben Gesichter – das gibt Sicherheit, gerade bei Demenz.</p></div></li>
          <li><span class="ico"><Icon name="clipboard" /></span><div><h3>Wir kümmern uns um die Anträge</h3><p>Pflegegrad, Verhinderungspflege, Hilfsmittel: Wir helfen beim Papierkram und rechnen direkt ab.</p></div></li>
          <li><span class="ico"><Icon name="hands" /></span><div><h3>Überleitung aus dem Krankenhaus</h3><p>Wir beraten schon vor der Entlassung, damit zu Hause alles bereit ist.</p></div></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">So einfach geht's</span>
        <h2>In drei Schritten zur passenden Pflege</h2>
      </div>
      <ol class="steps">
        <li><span class="n">1</span><h3>Anrufen oder schreiben</h3><p>Telefon, WhatsApp oder Formular – wir melden uns noch am selben Werktag.</p></li>
        <li><span class="n">2</span><h3>Kostenlose Erstbegutachtung</h3><p>Eine Pflegefachkraft besucht Sie zu Hause und erfasst den Bedarf.</p></li>
        <li><span class="n">3</span><h3>Pflege startet</h3><p>Mit festem Plan, festen Ansprechpartnern und Abrechnung über die Kasse.</p></li>
      </ol>
      <div class="center"><a class="btn btn--primary" href="/erstbegutachtung/">Jetzt Termin anfragen <Icon name="arrow" size={20} /></a></div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="head head--center">
        <span class="eyebrow">Stimmen von Angehörigen</span>
        <h2>Was Familien über uns sagen</h2>
      </div>
      <Testimonials />
      <div class="certs-wrap">
        <h2 class="h3">Zulassungen & Qualität</h2>
        <Certificates />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--area">
      <div>
        <span class="eyebrow">Einsatzgebiet</span>
        <h2>Für Sie da in ganz Dortmund</h2>
        <p class="lead">Von unserem Büro in Hörde erreichen wir den Dortmunder Süden und die Innenstadt besonders schnell. Weitere Stadtteile versorgen wir auf Anfrage.</p>
        <a class="btn btn--ghost" href="/kontakt/"><Icon name="pin" size={20} /> Kontakt & Anfahrt</a>
      </div>
      <ServiceArea />
    </div>
  </section>

  <section class="section section--soft" id="rueckruf">
    <div class="wrap split split--form">
      <div>
        <span class="eyebrow">Kostenlose Beratung</span>
        <h2>Wir rufen Sie zurück</h2>
        <p class="lead">Hinterlassen Sie Namen und Telefonnummer. Eine Pflegefachkraft meldet sich und beantwortet Ihre Fragen – kostenlos und unverbindlich.</p>
        <ul class="checks">
          <li>Antwort in der Regel am selben Werktag</li>
          <li>Beratung zu Pflegegrad und Finanzierung</li>
          <li>Keine Verpflichtung, keine Kosten</li>
        </ul>
      </div>
      <div class="card"><ContactForm variant="rueckruf" id="rueckruf-form" /></div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--faq">
      <div class="head">
        <span class="eyebrow">Häufige Fragen</span>
        <h2>Antworten für Angehörige</h2>
        <p class="lead">Sie haben eine andere Frage? Rufen Sie uns an – wir nehmen uns Zeit.</p>
        <a class="btn btn--ghost" href={SITE.phoneHref}><Icon name="phone" size={20} /> {SITE.phone}</a>
      </div>
      <Faq items={FAQ} />
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section section--soft">
      <div class="wrap">
        <div class="head row-head">
          <div><span class="eyebrow">Pflege-Ratgeber</span><h2>Wissen für pflegende Angehörige</h2></div>
          <a class="btn btn--ghost" href="/blog/">Alle Artikel <Icon name="arrow" size={18} /></a>
        </div>
        <div class="grid grid-3">
          {posts.map((p) => (
            <a class="card post" href={`/blog/${p.id}/`}>
              <time datetime={p.data.date.toISOString()}>{p.data.date.toLocaleDateString('de-DE', { day: '2-digit', month: 'long', year: 'numeric' })}</time>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
              <span class="more">Weiterlesen <Icon name="arrow" size={18} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <CtaBand />
</Base>
<style>
  .hero { background: radial-gradient(900px 500px at 85% 0%, var(--brand-50), transparent 65%), radial-gradient(600px 400px at 0% 100%, var(--green-50), transparent 60%); padding-block: clamp(36px, 6vw, 80px) clamp(40px, 6vw, 72px); overflow: hidden; }
  .hero-in { display: grid; grid-template-columns: 1.15fr 1fr; gap: clamp(30px, 5vw, 64px); align-items: center; }
  .hero h1 { margin-block: 18px 20px; }
  .hl { color: var(--brand-600); }
  .hero .lead { max-width: 560px; margin-block-end: 28px; }
  .trust { display: flex; flex-wrap: wrap; gap: 10px 22px; list-style: none; padding: 0; margin: 28px 0 0; color: var(--ink-2); font-weight: 600; }
  .trust li { display: flex; gap: 8px; align-items: center; }
  .trust :global(svg) { color: var(--green-700); }
  .hero-vis { position: relative; justify-self: center; inline-size: min(100%, 460px); }
  .ring { position: absolute; inset: -6%; border-radius: 50%; border: 14px solid var(--green); opacity: .9; }
  .ring::before { content: ''; position: absolute; inset: 14px; border-radius: 50%; background: var(--brand); }
  .hero-img { position: relative; inline-size: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 50%; border: 10px solid #fff; box-shadow: var(--shadow-lg); }
  .float { position: absolute; display: flex; gap: 12px; align-items: center; background: #fff; border-radius: 16px; padding: 12px 16px; box-shadow: var(--shadow-lg); line-height: 1.25; }
  .float small { display: block; color: var(--muted); font-size: .82rem; }
  .float .ico { margin: 0; inline-size: 40px; block-size: 40px; border-radius: 12px; }
  .f1 { inset-block-end: 4%; inset-inline-start: -8%; }
  .f2 { inset-block-start: 6%; inset-inline-end: -4%; display: grid; text-align: center; gap: 0; }
  .f2 b { font-size: 1.3rem; color: var(--brand-700); }
  .quick { margin-block-start: -8px; }
  .quick-in { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; }
  .q { display: flex; gap: 14px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: 18px; padding: 16px 18px; text-decoration: none; color: var(--ink); box-shadow: var(--shadow); transition: transform .15s, border-color .15s; }
  .q:hover { transform: translateY(-2px); border-color: var(--brand); color: var(--ink); }
  .q .ico { margin: 0; inline-size: 48px; block-size: 48px; }
  .q span:last-child { display: grid; line-height: 1.3; }
  .q small { color: var(--muted); }
  .svc { display: flex; flex-direction: column; text-decoration: none; color: var(--ink); transition: transform .15s, border-color .15s, box-shadow .15s; }
  .svc:hover { transform: translateY(-3px); border-color: var(--brand-100); box-shadow: var(--shadow-lg); color: var(--ink); }
  .svc p { color: var(--ink-2); flex: 1; }
  .svc--cta { background: linear-gradient(160deg, var(--green-50), #fff 60%); }
  .more { display: inline-flex; gap: 6px; align-items: center; font-weight: 700; color: var(--brand-600); margin-block-start: 8px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(32px, 5vw, 72px); align-items: center; }
  .split--form, .split--faq { align-items: start; }
  .split--faq { grid-template-columns: .8fr 1.2fr; }
  .media { position: relative; }
  .media img { inline-size: 100%; aspect-ratio: 4/3.4; object-fit: cover; border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); }
  .stat { position: absolute; inset-block-end: -22px; inset-inline-end: 22px; background: var(--brand-600); color: #fff; border-radius: 18px; padding: 16px 20px; display: grid; box-shadow: var(--shadow-lg); }
  .stat b { font-size: 1.8rem; line-height: 1; }
  .why { list-style: none; padding: 0; margin: 26px 0 0; display: grid; gap: 22px; }
  .why li { display: flex; gap: 16px; }
  .why .ico { margin: 0; }
  .why h3 { font-size: 1.1rem; margin-block-end: 4px; }
  .why p { margin: 0; color: var(--ink-2); }
  .steps { list-style: none; padding: 0; margin: 0 0 36px; display: grid; grid-template-columns: repeat(3, 1fr); gap: 22px; counter-reset: s; }
  .steps li { position: relative; padding: 30px 26px; border-radius: var(--radius); background: var(--bg-soft); }
  .steps li:not(:last-child)::after { content: ''; position: absolute; inset-block-start: 52px; inset-inline-end: -18px; inline-size: 14px; block-size: 14px; border-block-start: 3px solid var(--brand-100); border-inline-end: 3px solid var(--brand-100); rotate: 45deg; }
  .n { display: grid; place-items: center; inline-size: 44px; block-size: 44px; border-radius: 50%; background: var(--brand-600); color: #fff; font-weight: 800; font-size: 1.2rem; margin-block-end: 16px; }
  .steps p { margin: 0; color: var(--ink-2); }
  .center { text-align: center; }
  .certs-wrap { margin-block-start: 56px; }
  .h3 { font-size: 1.3rem; text-align: center; margin-block-end: 22px; }
  .row-head { max-width: none; display: flex; justify-content: space-between; align-items: end; gap: 20px; flex-wrap: wrap; }
  .row-head h2 { margin: 0; }
  .post { text-decoration: none; color: var(--ink); display: flex; flex-direction: column; }
  .post:hover { border-color: var(--brand-100); color: var(--ink); }
  .post p { color: var(--ink-2); flex: 1; }
  time { font-size: .86rem; color: var(--muted); margin-block-end: 8px; }
  @media (max-width: 980px) {
    .hero-in, .split, .split--faq { grid-template-columns: 1fr; }
    .hero-vis { inline-size: min(78%, 400px); margin-block-start: 20px; }
    .quick-in { grid-template-columns: 1fr 1fr; }
    .steps { grid-template-columns: 1fr; }
    .steps li::after { display: none; }
  }
  @media (max-width: 520px) {
    .quick-in { grid-template-columns: 1fr; }
    .f1 { inset-inline-start: -4%; }
    .q { padding: 12px 14px; }
  }
</style>
