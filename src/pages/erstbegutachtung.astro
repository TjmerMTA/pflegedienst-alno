---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import { SITE, whatsappUrl, getPage, escText } from '../config/site';
// Тексты — в src/content/pages/erstbegutachtung.json (правятся в админке)
const p = getPage('erstbegutachtung');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ label: p.text('hero.crumb') }]} />
  <section class="section">
    <div class="wrap layout">
      <div class="card">
        <h2>{p.text('form.h2')}</h2>
        <p class="muted">{p.text('form.noteBefore')} <a href={SITE.phoneHref}>{SITE.phone}</a> {p.text('form.noteAfter')}</p>
        <ContactForm variant="erstbegutachtung" id="eb-form" />
      </div>
      <aside>
        <h2 class="h3">{p.text('expect.h2')}</h2>
        <ol class="tl">
          {p.list<{ icon: string; title: string; text: string }>('expect.items').map((e) => (
            <li><span><Icon name={e.icon} size={18} /></span><div><b set:html={escText(e.title)} /><p>{e.text}</p></div></li>
          ))}
        </ol>
        <div class="card mini">
          <b>{p.text('prepare.title')}</b>
          <ul class="checks">{p.list<{ text: string }>('prepare.items').map((i) => <li>{i.text}</li>)}</ul>
        </div>
        <div class="btn-row">
          <a class="btn btn--ghost" href={SITE.phoneHref}><Icon name="phone" size={20} /> {p.text('buttons.call')}</a>
          <a class="btn btn--wa" href={whatsappUrl} target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> {p.text('buttons.whatsapp')}</a>
        </div>
      </aside>
    </div>
  </section>
</Base>
<style>
  .layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: start; }
  .layout h2 { font-size: 1.6rem; margin-block-end: .2em; }
  .h3 { font-size: 1.35rem !important; margin-block-end: 20px !important; }
  .tl { list-style: none; padding: 0; margin: 0 0 24px; display: grid; gap: 4px; }
  .tl li { display: flex; gap: 14px; position: relative; padding-block-end: 16px; }
  .tl li:not(:last-child)::before { content: ''; position: absolute; inset-inline-start: 19px; inset-block: 42px 0; border-inline-start: 2px dashed var(--brand-100); }
  .tl li > span { flex: none; display: grid; place-items: center; inline-size: 40px; block-size: 40px; border-radius: 50%; background: var(--brand-50); color: var(--brand-600); }
  .tl p { margin: 2px 0 0; color: var(--ink-2); font-size: .95rem; }
  .mini { padding: 20px; margin-block-end: 20px; box-shadow: none; background: var(--bg-soft); }
  .mini .checks { margin: 12px 0 0; }
  @media (max-width: 900px) { .layout { grid-template-columns: 1fr; } }
</style>
