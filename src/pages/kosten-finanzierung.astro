---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import { faqSchema } from '../config/faq';

// Тексты — в src/content/pages/kosten-finanzierung.json (правятся в админке)
// Импорт динамический: новый статический сдвинул бы порядок <style> на страницах (см. Certificates.astro)
const { getPage, escText } = await import('../lib/content');
const p = getPage('kosten-finanzierung');
const faq = p.list<{ q: string; a: string }>('faq.items');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')} schema={[faqSchema(faq)]}>
  <PageHero title={p.text('hero.title')} lead={p.text('hero.lead')} crumbs={[{ label: p.text('hero.crumb') }]} />

  <section class="section">
    <div class="wrap">
      <div class="grid grid-3">
        {p.list<{ icon: string; title: string; before: string; bold: string; after: string }>('cards.items').map((c, i) => (
          <div class="card"><span class:list={['ico', { 'ico--green': i % 2 }]}><Icon name={c.icon} /></span><h2 class="h3" set:html={escText(c.title)} /><p>{c.before} <b>{c.bold}</b> {c.after}</p></div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">{p.text('table.eyebrow')}</span>
        <h2>{p.text('table.h2')}</h2>
        <p class="lead">{p.text('table.lead')}</p>
      </div>
      <div class="table-wrap card tbl">
        <table>
          <thead><tr><th scope="col">{p.text('table.colGrad')}</th><th scope="col">{p.text('table.colGeld')}<br /><small>{p.text('table.colGeldSub')}</small></th><th scope="col">{p.text('table.colSach')}<br /><small>{p.text('table.colSachSub')}</small></th><th scope="col">{p.text('table.colEnt')}<br /><small>{p.text('table.colEntSub')}</small></th></tr></thead>
          <tbody>{p.list<{ grad: string; geld: string; sach: string; ent: string }>('table.rows').map((r) => <tr><th scope="row">{r.grad}</th><td>{r.geld}</td><td><b>{r.sach}</b></td><td>{r.ent}</td></tr>)}</tbody>
        </table>
      </div>
      <p class="muted small">{p.text('table.note')}</p>
      <a class="card calc calc--gap" href="/pflege-rechner/">
        <span class="ico ico--green"><Icon name="euro" /></span>
        <div><h2 class="h3">{p.text('calc.title')}</h2><p>{p.text('calc.text')}</p></div>
        <span class="btn btn--primary">{p.text('calc.button')} <Icon name="arrow" size={20} /></span>
      </a>
    </div>
  </section>

  <section class="section">
    <div class="wrap prose-grid">
      <div class="prose">
        <h2>{p.text('prose.verhinderungTitle')}</h2>
        <p>{p.text('prose.verhinderungBefore')} <b>{p.text('prose.verhinderungBold')}</b> {p.text('prose.verhinderungAfter')} <a href="/leistungen/verhinderungspflege/">{p.text('prose.verhinderungLink')}</a>.</p>
        <h2>{p.text('prose.behandlungTitle')}</h2>
        <p>{p.text('prose.behandlungText')}</p>
        <h2>{p.text('prose.beratungTitle')}</h2>
        <p>{p.text('prose.beratungText')} <a href="/leistungen/pflegeberatung-37-3/">{p.text('prose.beratungLink')}</a></p>
      </div>
      <aside class="card tip">
        <span class="ico ico--solid"><Icon name="info" /></span>
        <h2 class="h3">{p.text('tip.title')}</h2>
        <p>{p.text('tip.text')}</p>
        <a class="btn btn--primary" href="/erstbegutachtung/">{p.text('tip.button')}</a>
      </aside>
    </div>
  </section>

  <section class="section section--soft">
    <div class="wrap narrow">
      <h2>{p.text('faq.h2')}</h2>
      <Faq items={faq} />
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .h3 { font-size: 1.25rem; }
  .tbl { padding: 0; overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; min-width: 620px; }
  th, td { padding: 16px 20px; text-align: start; border-block-end: 1px solid var(--line); }
  thead th { background: var(--brand-700); color: #fff; font-size: .95rem; vertical-align: top; }
  thead small { font-weight: 400; opacity: .8; }
  tbody tr:nth-child(even) { background: var(--bg-soft); }
  tbody tr:last-child > * { border: 0; }
  td b { color: var(--brand-700); }
  .small { font-size: .9rem; margin-block-start: 14px; }
  .prose-grid { display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: start; }
  .prose h2:first-child { margin-block-start: 0; }
  .tip { display: flex; flex-direction: column; align-items: center; text-align: center; background: linear-gradient(160deg, var(--green-50), #fff 60%); }
  .tip .btn { margin-block-start: 6px; }
  .calc--gap { margin-block-start: clamp(28px, 4vw, 44px); }
  .calc { display: grid; grid-template-columns: auto 1fr auto; gap: 24px; align-items: center; text-decoration: none; color: var(--ink); background: linear-gradient(160deg, var(--green-50), #fff 60%); transition: transform .15s, box-shadow .15s; }
  .calc:hover { transform: translateY(-2px); box-shadow: var(--shadow-lg); color: var(--ink); }
  .calc .ico, .calc h2, .calc p { margin: 0; }
  .calc p { color: var(--ink-2); margin-block-start: 4px; }
  @media (max-width: 760px) { .calc { grid-template-columns: 1fr; gap: 16px; } .calc .ico { margin-block-end: 0; } }
  .narrow { max-width: 820px; }
  @media (max-width: 900px) { .prose-grid { grid-template-columns: 1fr; } }
</style>
