---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import CtaBand from '../../components/CtaBand.astro';
const items = (await getCollection('leistungen')).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Leistungen: Grundpflege, Behandlungspflege, Verhinderungspflege" description="Alle Leistungen des Pflegedienstes ALNO in Dortmund: Grundpflege, Behandlungspflege, Verhinderungspflege, Betreuung, Hauswirtschaft und Beratungsbesuche nach § 37.3.">
  <PageHero title="Unsere Leistungen in Dortmund" lead="Wir stellen die Versorgung so zusammen, wie Sie oder Ihr Angehöriger sie brauchen – und rechnen direkt mit Pflege- und Krankenkasse ab." crumbs={[{ label: 'Leistungen' }]} />
  <section class="section">
    <div class="wrap list">
      {items.map((l, i) => (
        <article class="card row" id={l.id}>
          <div class="l">
            <span class:list={['ico', { 'ico--green': i % 2 }]}><Icon name={l.data.icon} /></span>
            <h2><a href={`/leistungen/${l.id}/`}>{l.data.title}</a></h2>
            <p>{l.data.teaser}</p>
            <p class="payer"><Icon name="euro" size={18} /> {l.data.payer}</p>
            <a class="btn btn--ghost" href={`/leistungen/${l.id}/`}>Details <Icon name="arrow" size={18} /></a>
          </div>
          <ul class="checks">{l.data.highlights.map((h) => <li>{h}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .list { display: grid; gap: 22px; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: start; }
  h2 { font-size: 1.6rem; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { color: var(--brand-700); }
  .payer { display: flex; gap: 8px; align-items: center; font-weight: 600; color: var(--green-700); font-size: .95rem; }
  .checks { margin-block-start: 8px; }
  @media (max-width: 820px) { .row { grid-template-columns: 1fr; } }
</style>
