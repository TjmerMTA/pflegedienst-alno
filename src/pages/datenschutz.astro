---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { getPage } from '../lib/content';

// Тексты — в src/content/pages/datenschutz.json (правятся в админке). id="cookies" — якорь из подвала, поэтому разделы заданы в коде
const p = getPage('datenschutz');
---
<Base title={p.text('seo.title')} description={p.text('seo.description')}>
  <PageHero title={p.text('hero.title')} crumbs={[{ label: p.text('hero.crumb') }]} />
  <section class="section">
    <div class="wrap prose">
      <p class="muted">{p.text('hinweis.note')}</p>
      <h2>{p.text('verantwortlicher.title')}</h2>
      <Fragment set:html={p.html('verantwortlicher.text')} />

      <h2>{p.text('rechte.title')}</h2>
      <Fragment set:html={p.html('rechte.text')} />

      <h2>{p.text('hosting.title')}</h2>
      <Fragment set:html={p.html('hosting.text')} />

      <h2>{p.text('schriften.title')}</h2>
      <Fragment set:html={p.html('schriften.text')} />

      <h2>{p.text('formular.title')}</h2>
      <Fragment set:html={p.html('formular.text')} />

      <h2>{p.text('whatsapp.title')}</h2>
      <Fragment set:html={p.html('whatsapp.text')} />

      <h2>{p.text('karte.title')}</h2>
      <Fragment set:html={p.html('karte.text')} />

      <h2 id="cookies">{p.text('cookies.title')}</h2>
      <Fragment set:html={p.html('cookies.text')} />

      <h2>{p.text('ssl.title')}</h2>
      <Fragment set:html={p.html('ssl.text')} />
    </div>
  </section>
</Base>
